func _ready() -> void:
	_apply_openarm_collision_contract()
	var configured_terminal_reason := str(goal_event.terminal_reason)
	if not configured_terminal_reason.is_empty():
		_goal_terminal_reason = configured_terminal_reason
	_bind_grasp_target()
	_calibrate_grasp_geometry()
	arm.target = target
	arm.target_pose = target_pose
	_spawn_target_axes_gizmo()
	if "manual_random_target_region" in arm:
		arm.manual_random_target_region = easy_target_region
	arm.target_reached.connect(_on_target_reached)
	arm.target_pose_relocated.connect(_on_target_pose_relocated)
	arm.obstacle_collision.connect(_on_obstacle_collision)
	controller.scenario_configured.connect(_on_scenario_configured)
	controller.episode_reset_started.connect(_on_episode_reset_started)
	controller.episode_reset_completed.connect(_on_episode_reset_completed)
	_apply_continuous_pose_tracking(continuous_pose_tracking)
	_validate_sampling_regions()
	_require_calibrated_gripper()
	_setup_transport()


## Refuse to run a grasp task with an uncalibrated gripper.
##
## Saving this scene from the editor once wrote `gripper_finger_link_names = []` onto the agent
## instance, overriding the two finger links the agent scene declares. Calibration then returned at
## its first line, `grasp_window()` returned {}, and the capture condition could never fire -- a
## grasp task in which grasping was impossible, with no error anywhere. Nothing else noticed: the
## arm still approached, still collected shaping, still ended episodes on the stall guard.
##
## The scenario already re-asserts the self-collision link lists after the same class of accident
## (`_apply_openarm_collision_contract`). The finger links belong to the agent scene, so rather than
## silently re-asserting them here too, this fails closed and says which property is empty.
func _require_calibrated_gripper() -> void:
	# Only scenes that actually carry a graspable object are grasp tasks. The reach-hold scene shares
	# this script and has no gripper at all, and failing it closed here would be a false alarm.
	if grasp_target == null or arm == null or not arm.has_method("grasp_window"):
		return
	if not (arm.call("grasp_window") as Dictionary).is_empty():
		return
	push_error(
		("[openarm] the gripper is not calibrated, so the object can never be captured. "
		+ "gripper_finger_link_names on OpenarmAgent is %s -- if that is empty, the scene has an "
		+ "override clearing what agents/RobotArms/openarm/openarm_agent.tscn declares. "
		+ "Terminating (fail-closed).") % str(arm.get("gripper_finger_link_names")))
	get_tree().quit(1)


## Everything transport needs that is derived from the scene, plus the checks that must fail loudly
## rather than produce a task that cannot be completed. This project has already lost 2929 episodes
## to a target region nobody measured; a bin nobody measured would be the same mistake twice.
func _setup_transport() -> void:
	if not transport_enabled:
		return
	if transport_drop_area == null:
		push_error(
			"[openarm] transport_enabled but transport_drop_area is unassigned: a release could "
			+ "never be judged, so every episode would be unwinnable. Terminating (fail-closed).")
		get_tree().quit(1)
		return
	_compute_release_point()
	if not _release_point_valid:
		push_error(
			"[openarm] transport_drop_area's parent is not a sized CSG box, so the release point "
			+ "cannot be derived from the scene. Terminating (fail-closed).")
		get_tree().quit(1)
		return
	# A waypoint tolerance at or below the success gate lets the arm satisfy its own success
	# condition while merely hovering at the lift point, ending the episode mid-task.
	if transport_waypoint_distance <= arm.success_distance:
		push_error(
			"[openarm] transport_waypoint_distance (%.3f m) must exceed success_distance (%.3f m), "
			% [transport_waypoint_distance, arm.success_distance]
			+ "or the arm can succeed at a waypoint. Terminating (fail-closed).")
		get_tree().quit(1)
		return
	print(
		"[openarm] transport: rilascio (%.3f, %.3f, %.3f)  apertura %.3f x %.3f m"
		% [
			_release_point.x, _release_point.y, _release_point.z,
			_release_opening.size.x, _release_opening.size.y,
		])


## Where the tool sits with the arm at its home joints, read by forward kinematics from the real
## robot rather than written into the scene, so it follows joint_home_positions automatically.
##
## Taken at the first completed reset, NOT at _ready: at _ready the robot may not have been built
## and posed yet, so the tool transform there is whatever the scene happened to be saved with. A
## reset has just teleported the arm home, which is exactly the pose being measured.
func _capture_home_tool_transform() -> void:
	if _home_tool_valid or not transport_enabled:
		return
	# ONLY after a regular reset. A bootstrap reset seeds the arm at a recorded PRE-GRASP, so
	# measuring there records a pose over the table as "home" and the return leg would send the arm
	# back onto the table instead of to rest. Seen live: three envs reported three different homes,
	# (0.270, 0.496, 0.280) -- the real one -- alongside (0.355, 0.492, 0.093) and
	# (0.387, 0.493, 0.132), which are grasp poses.
	if not _last_reset_was_regular:
		return
	var tool: Node3D = arm.tool_pose if arm != null else null
	if tool == null:
		return
	_home_tool_transform = tool.global_transform
	_home_tool_valid = true
	print("[openarm] transport: casa utensile (%.3f, %.3f, %.3f)" % [
		_home_tool_transform.origin.x, _home_tool_transform.origin.y,
		_home_tool_transform.origin.z])


## Rebind the arm's target to the graspable body.
func _bind_grasp_target() -> void:
	if grasp_target == null:
		return
	if grasp_target_pose == null:
		grasp_target_pose = grasp_target.get_node_or_null("GraspPose") as Node3D
	if grasp_target_pose == null:
		push_error(
			"[openarm_scenario] grasp_target '%s' has no grasp pose marker "
			% grasp_target.name
			+ "(assign grasp_target_pose or add a GraspPose child). Terminating (fail-closed).")
		get_tree().quit(1)
		return
	target = grasp_target
	# The demanded pose is a node of its OWN, parked where the glass spawned -- not the marker inside
	# the glass. The marker rides the object, so once the grasp attaches it the demanded pose travels
	# with the hand: the distance gate freezes at whatever it was at capture and stays satisfied no
	# matter where the arm carries the glass. Seen in a rendered run as the arm lifting the glass
	# away while the task still considered it on target. Capture geometry still uses the marker,
	# because that question is about where the OBJECT actually is.
	_demanded_pose = Marker3D.new()
	_demanded_pose.name = "DemandedGraspPose"
	add_child(_demanded_pose)
	_demanded_pose.global_transform = grasp_target_pose.global_transform
	target_pose = _demanded_pose
	arm.grasp_object_pose = grasp_target_pose
	# The grasp target is not an obstacle; contact with it is part of the task.
	if grasp_target.is_in_group(str(arm.obstacle_group)):
		push_error(
			"[openarm_scenario] grasp_target is in the '%s' group, so touching it would "
			% str(arm.obstacle_group)
			+ "terminate the episode. Remove it from that group. Terminating (fail-closed).")
		get_tree().quit(1)
		return
	if not grasp_target.is_in_group("graspable"):
		grasp_target.add_to_group("graspable")


## Measure the table and the glass instead of trusting numbers typed into the scene.
func _calibrate_grasp_geometry() -> void:
	if grasp_target == null:
		return
	var support := _support_footprint()
	if support.is_empty():
		push_error(
			"[openarm_scenario] grasp_support_body has no BoxShape3D to measure; the resting "
			+ "height cannot be derived. Terminating (fail-closed).")
		get_tree().quit(1)
		return
	_support_top_y = float(support["top_y"])
	_support_min = support["min_xz"] as Vector2
	_support_max = support["max_xz"] as Vector2

	var extent := _body_local_extent(grasp_target)
	if extent.is_empty():
		push_error(
			"[openarm_scenario] grasp_target '%s' has no measurable CollisionShape3D. "
			% grasp_target.name
			+ "Terminating (fail-closed).")
		get_tree().quit(1)
		return
	_object_base_offset = -float(extent["min_y"])
	_object_radius = float(extent["radius"])
	_grasp_calibrated = true

	print("[openarm_scenario] grasp calibration: table top y=%.4f footprint x=[%.4f, %.4f] z=[%.4f, %.4f] | object base_offset=%.4f radius=%.4f resting y=%.4f" % [
		_support_top_y,
		_support_min.x, _support_max.x,
		_support_min.y, _support_max.y,
		_object_base_offset,
		_object_radius,
		_support_top_y + _object_base_offset,
	])
	_warn_regions_overhang_support()
	_publish_grasp_geometry_to_arm()


## Passes object width and the matching initial gripper opening to the arm.
func _publish_grasp_geometry_to_arm() -> void:
	if arm == null:
		return
	var width := _object_radius * 2.0
	arm.grasp_object_width = width
	# Derive the penalty scales from the object unless they were overridden. Both are half-widths:
	# the pads can be at most half a width inside the object, and pushing it by half a width is a
	# clear miss. Deriving them keeps a resized glass from silently changing what the penalties mean.
	if grasp_disturbance_scale <= 0.0:
		grasp_disturbance_scale = width * 0.5
	if grasp_penetration_scale <= 0.0:
		grasp_penetration_scale = width * 0.5
	if not arm.has_method("grasp_closure_for_width"):
		return
	var open_travel: float = arm.call(
		"grasp_closure_for_width", width + maxf(grasp_initial_clearance, 0.0))
	var home: PackedFloat32Array = arm.joint_home_positions.duplicate()
	var gripper_index := Array(arm.get_controlled_joint_names()).find(
		String(arm.gripper_joint_name))
	if gripper_index < 0:
		push_warning(
			"[openarm_scenario] the gripper joint is not in the action space, so the claws "
			+ "cannot start open. Add it to controlled_joint_names.")
		return
	while home.size() <= gripper_index:
		home.append(0.0)
	home[gripper_index] = open_travel
	arm.joint_home_positions = home
	print("[openarm_scenario] object width %.4f m -> start travel %.4f m (pad gap %.4f m), grasp travel %.4f m" % [
		width,
		open_travel,
		width + maxf(grasp_initial_clearance, 0.0),
		float(arm.call("grasp_closure_for_width", width)),
	])


## The glass rim, not its centre, is what leaves the table.
func _warn_regions_overhang_support() -> void:
	var clearance := _object_radius + maxf(grasp_support_margin, 0.0)
	for region in [easy_target_region, medium_target_region, hard_target_region]:
		if region == null:
			continue
		var bounds := _region_xz_bounds(region)
		if bounds.is_empty():
			continue
		var region_min := bounds["min_xz"] as Vector2
		var region_max := bounds["max_xz"] as Vector2
		var slack := Vector4(
			region_min.x - clearance - _support_min.x,
			_support_max.x - (region_max.x + clearance),
			region_min.y - clearance - _support_min.y,
			_support_max.y - (region_max.y + clearance))
		var tightest := minf(minf(slack.x, slack.y), minf(slack.z, slack.w))
		if tightest < 0.0:
			push_warning(
				("[openarm_scenario] region '%s' overhangs the table by %.1f mm once the glass "
				+ "radius (%.1f mm) and margin (%.1f mm) are counted. Resize the region in the "
				+ "editor -- the sampler is deliberately NOT retreating it.") % [
					region.name, -tightest * 1000.0,
					_object_radius * 1000.0, grasp_support_margin * 1000.0])
		else:
			print("[openarm_scenario] region '%s' fits the table with %.1f mm to spare on its tightest side" % [
				region.name, tightest * 1000.0])


## World-space top surface and xz footprint of the support body's first BoxShape3D.
func _support_footprint() -> Dictionary:
	var body := grasp_support_body
	if body == null:
		body = get_node_or_null("Workcell/Table") as PhysicsBody3D
	if body == null:
		return {}
	for child in body.get_children():
		var shape_node := child as CollisionShape3D
		if shape_node == null:
			continue
		var box := shape_node.shape as BoxShape3D
		if box == null:
			continue
		var centre := shape_node.global_position
		var half := box.size * 0.5
		return {
			"top_y": centre.y + half.y,
			"min_xz": Vector2(centre.x - half.x, centre.z - half.z),
			"max_xz": Vector2(centre.x + half.x, centre.z + half.z),
		}
	return {}


## Lowest point and largest horizontal radius of a body's collision geometry, in the body's own frame.
func _body_local_extent(body: PhysicsBody3D) -> Dictionary:
	var min_y := INF
	var radius := 0.0
	var found := false
	for child in body.get_children():
		var shape_node := child as CollisionShape3D
		if shape_node == null or shape_node.shape == null:
			continue
		var local := shape_node.transform
		for point in _shape_hull_points(shape_node.shape):
			var p: Vector3 = local * point
			min_y = minf(min_y, p.y)
			radius = maxf(radius, Vector2(p.x, p.z).length())
			found = true
	if not found:
		return {}
	return {"min_y": min_y, "radius": radius}


## Corner/vertex set standing in for a shape's extent.
func _shape_hull_points(shape: Shape3D) -> PackedVector3Array:
	if shape is ConvexPolygonShape3D:
		return (shape as ConvexPolygonShape3D).points
	if shape is BoxShape3D:
		var half := (shape as BoxShape3D).size * 0.5
		var corners := PackedVector3Array()
		for sx in [-1.0, 1.0]:
			for sy in [-1.0, 1.0]:
				for sz in [-1.0, 1.0]:
					corners.append(Vector3(half.x * sx, half.y * sy, half.z * sz))
		return corners
	if shape is CylinderShape3D:
		var cylinder := shape as CylinderShape3D
		var points := PackedVector3Array()
		var half_height := cylinder.height * 0.5
		for i in range(8):
			var a := TAU * float(i) / 8.0
			var x := cos(a) * cylinder.radius
			var z := sin(a) * cylinder.radius
			points.append(Vector3(x, -half_height, z))
			points.append(Vector3(x, half_height, z))
		return points
	if shape is SphereShape3D:
		var r := (shape as SphereShape3D).radius
		return PackedVector3Array([
			Vector3(-r, -r, -r), Vector3(r, r, r),
			Vector3(-r, r, r), Vector3(r, -r, -r)])
	return PackedVector3Array()


## World-space xz box a sampling region can place a target centre in, inset included.
func _region_xz_bounds(region: Area3D) -> Dictionary:
	var shape_node := region.get_node_or_null("CollisionShape3D") as CollisionShape3D
	if shape_node == null:
		return {}
	var box := shape_node.shape as BoxShape3D
	if box == null:
		return {}
	var half := box.size * 0.5
	var inset := Vector3.ZERO
	if "sampling_inset" in region:
		inset = region.sampling_inset as Vector3
	var usable := Vector3(
		maxf(half.x - inset.x, 0.0),
		maxf(half.y - inset.y, 0.0),
		maxf(half.z - inset.z, 0.0))
	var centre := shape_node.global_position
	return {
		"min_xz": Vector2(centre.x - usable.x, centre.z - usable.z),
		"max_xz": Vector2(centre.x + usable.x, centre.z + usable.z),
	}


## Rejects target regions with missing geometry or an empty active allowlist.
func _validate_sampling_regions() -> void:
	for region in [easy_target_region, medium_target_region, hard_target_region]:
		if region == null or not region.has_method("active_cells"):
			continue
		var has_allowlist: bool = ("allowed_cells" in region) and not region.allowed_cells.is_empty()
		if has_allowlist and region.active_cells().is_empty():
			push_error(
				"[openarm_scenario] region '%s' has allowed_cells set but no valid cell; "
				% region.name
				+ "invalid sampler configuration (fail-closed). Terminating.")
			get_tree().quit(1)
			return


## Draws axis triads for the target grasp frame and tool frame.
func _spawn_target_axes_gizmo() -> void:
	if DisplayServer.get_name() == "headless":
		return
	_target_axes_source = target_pose
	_target_axes = _spawn_axes_gizmo(0.06, target_pose)
	if arm != null:
		# The arm's OWN resolved tool frame, not a hardcoded path: grasping moved the tool point to
		# the measured pad centre (a GraspCenter marker below ToolPose), and a gizmo drawn on the
		# old node would sit 7.5 mm behind the point every metric is actually measured from.
		var tool_pose: Node3D = arm.tool_pose
		if tool_pose == null:
			tool_pose = (arm as Node3D).get_node_or_null("EndEffector") as Node3D
		_tool_axes_source = tool_pose
		_tool_axes = _spawn_axes_gizmo(0.045, tool_pose)
	_spawn_target_height_ray()


## Draws target height against the first support surface below it.
func _spawn_target_height_ray() -> void:
	if target == null:
		return
	var material := StandardMaterial3D.new()
	material.albedo_color = Color(1.0, 0.85, 0.2)
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED

	var ray_mesh := BoxMesh.new()
	ray_mesh.size = Vector3(0.004, 1.0, 0.004)
	ray_mesh.material = material
	_target_height_ray = MeshInstance3D.new()
	_target_height_ray.name = "TargetHeightRay"
	_target_height_ray.mesh = ray_mesh
	add_child(_target_height_ray)

	var mark_mesh := BoxMesh.new()
	mark_mesh.size = Vector3(0.04, 0.002, 0.04)
	mark_mesh.material = material
	_target_height_mark = MeshInstance3D.new()
	_target_height_mark.name = "TargetHeightMark"
	_target_height_mark.mesh = mark_mesh
	add_child(_target_height_mark)


func _process(_delta: float) -> void:
	_refresh_debug_overlays()


## Put the axis triads and the height ray back on the frames they describe. Called every idle frame
## and again explicitly after a reset, because under lockstep the tree spends most of its time
## paused and an idle frame is not guaranteed when it matters.
func _refresh_debug_overlays() -> void:
	# The axis triads are parented to their frames and need no work here; only the height ray is
	# computed geometry (it measures down to whatever surface is below the glass) and has to be
	# rebuilt.
	if _target_height_ray == null or target == null:
		return
	var point := target.global_position
	var surface_y := _surface_below(point)
	var height := maxf(point.y - surface_y, 0.001)
	_target_height_ray.global_transform = Transform3D(
		Basis.IDENTITY.scaled(Vector3(1.0, height, 1.0)),
		Vector3(point.x, surface_y + height * 0.5, point.z))
	_target_height_mark.global_transform = Transform3D(
		Basis.IDENTITY, Vector3(point.x, surface_y + 0.002, point.z))


## Finds the first support surface below a point.
func _surface_below(point: Vector3) -> float:
	if not is_inside_tree():
		return 0.0
	var query := PhysicsRayQueryParameters3D.create(
		point + Vector3.UP * 0.001, point + Vector3.DOWN * 5.0)
	query.collide_with_areas = false
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	var collider: Variant = hit.get("collider")
	if collider is Node and (
		(collider as Node).is_in_group("robot_obstacle")
		or (collider as Node).name == "Floor"
	):
		return (hit["position"] as Vector3).y
	return 0.0


## Three unshaded rods (X red, Y green, Z blue).
## Parented to the frame it describes, NOT copied onto it every idle frame.
##
## Copying was the bug: the overlays were refreshed from _process, and under lockstep the tree is
## paused between commands, so the gizmo only moved on the frames the trainer happened to give it --
## reported from a rendered run as an end-effector gizmo that freezes in place as the hand reaches
## the table. Parenting makes the scene graph carry the transform, so the gizmo cannot lag, cannot
## be left behind by a re-resolved tool node, and costs nothing per frame.
func _spawn_axes_gizmo(axis_length: float, frame: Node3D) -> Node3D:
	var holder := Node3D.new()
	holder.name = "AxesGizmo"
	if frame != null:
		frame.add_child(holder)
		# Inheriting the parent's scale would stretch the rods; URDF links import at unit scale, so
		# this is a guard rather than a routine correction, and it says so if it ever fires.
		var inherited := frame.global_basis.get_scale()
		if not inherited.is_equal_approx(Vector3.ONE):
			push_warning(
				"AxesGizmo parent %s carries scale %s; compensating." % [frame.name, inherited])
			holder.scale = Vector3.ONE / inherited
	else:
		add_child(holder)
	const AXIS_THICKNESS := 0.003
	var axis_colors := {
		Vector3.RIGHT: Color(1.0, 0.25, 0.25),
		Vector3.UP: Color(0.25, 1.0, 0.25),
		Vector3.BACK: Color(0.35, 0.55, 1.0),
	}
	for direction in axis_colors:
		var along: Vector3 = (direction as Vector3).abs()
		var mesh := BoxMesh.new()
		mesh.size = along * axis_length + (Vector3.ONE - along) * AXIS_THICKNESS
		var material := StandardMaterial3D.new()
		material.albedo_color = axis_colors[direction]
		material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		mesh.material = material
		var rod := MeshInstance3D.new()
		rod.name = "Axis%s" % str(direction)
		rod.mesh = mesh
		rod.position = (direction as Vector3) * axis_length * 0.5
		holder.add_child(rod)
	return holder


func _apply_openarm_collision_contract() -> void:
	if not arm.self_body_collision_enabled:
		return
	arm.self_body_link_names = required_self_body_links.duplicate()
	arm.self_check_link_names = required_self_check_links.duplicate()
	if arm.has_method("_refresh_collision_geometry"):
		arm.call_deferred("_refresh_collision_geometry")


func _physics_process(_delta: float) -> void:
	_refresh_grasp_pose_basis()
	_update_grasp_capture()
	_advance_transport_phase()
	_resolve_pending_drop()
	_check_object_tipped()
	if (
		not _training_mode
		or not relocate_target_during_training
		or _curriculum_episode() < target_relocation_start_episode
		or _target_relocation_step < 0
	):
		return
	var current_step := controller.step_count
	if current_step == _last_relocation_check_step:
		return
	_last_relocation_check_step = current_step
	if current_step >= _target_relocation_step:
		_relocate_target()


func _on_scenario_configured(config:Dictionary) -> void:
	_training_episode = int(config.get("training_episode", _training_episode))
	_curriculum_level_override = (
		clampf(float(config["curriculum_level"]), 0.0, 1.0)
		if config.has("curriculum_level")
		else -1.0)
	_training_mode = bool(config.get("training_mode", controller.training_mode))
	# Evaluation mode is distinct from ordinary non-training inference.
	_evaluation_mode = bool(config.get("evaluation_mode", false))
	_eval_region_deck.clear()
	_eval_region_deck_index = 0
	# A negative forced cell restores normal sampling within the selected region.
	# One exact target instead of a sampled one. Sent as [x, y, z]; y is overwritten by the support
	# height in _place_target anyway, so the glass still rests on the table rather than in mid-air.
	var fixed: Variant = config.get("fixed_target_position", null)
	if fixed is Array and (fixed as Array).size() >= 3:
		var values := fixed as Array
		_fixed_target_position = Vector3(
			float(values[0]), float(values[1]), float(values[2]))
		_has_fixed_target = true
		print("[openarm_scenario] target fissato a (%.4f, %.4f, %.4f)" % [
			_fixed_target_position.x, _fixed_target_position.y, _fixed_target_position.z])
	elif config.has("fixed_target_position"):
		_has_fixed_target = false
	_demo_mode = bool(config.get("demo_mode", false))
	_demo_forced_region = str(config.get("demo_forced_region", "easy")).strip_edges().to_lower()
	_demo_forced_cell = int(config.get("demo_forced_cell", -1))
	# Empty plans leave control to manual IK or the policy.
	_demo_plan_data = config.get("demo_plan", [])
	if typeof(_demo_plan_data) != TYPE_ARRAY:
		_demo_plan_data = []
	var continue_after_success := bool(config.get(
		"continue_after_success", false))
	var scene_tracking_enabled := continuous_pose_tracking
	if _curriculum_level_override >= 0.0:
		scene_tracking_enabled = (
			scene_tracking_enabled
			and _curriculum_level_override
			>= continuous_tracking_curriculum_level)
	_apply_continuous_pose_tracking(
		continue_after_success or scene_tracking_enabled)


func _apply_continuous_pose_tracking(enabled: bool) -> void:
	controller.continue_after_success = enabled
	if arm.has_method("set_continue_after_success"):
		arm.set_continue_after_success(enabled)
	goal_event.terminal_reason = "" if enabled else _goal_terminal_reason


func _curriculum_episode() -> int:
	if _curriculum_level_override >= 0.0:
		return roundi(
			_curriculum_level_override
			* float(maxi(adaptive_curriculum_full_episode, 1)))
	return _training_episode


func _target_spawn_pool() -> Array[Marker3D]:
	# Fall back to the explicit marker list when no root is assigned.
	var result: Array[Marker3D] = []
	if target_spawns_root:
		for child in target_spawns_root.get_children():
			if child is Marker3D:
				result.append(child)
	if result.is_empty():
		for marker in target_spawns:
			if marker:
				result.append(marker)
	return result


func _on_episode_reset_started(_seed:int) -> void:
	_release_object_for_reset()
	var spawn_pool := _target_spawn_pool()
	if spawn_pool.is_empty():
		push_error("RobotArmReachingScenario requires at least one TargetSpawn")
		return
	_episode_rng.seed = _seed
	_current_reset_seed = _seed
	# Load the per-episode demo plan (if any) so the arm tracks it closed-loop this episode.
	if _demo_mode and arm.has_method("set_demo_plan"):
		arm.set_demo_plan(_demo_plan_data, int(controller.physics_frames_per_step))
	_target_relocation_step = -1
	_last_relocation_check_step = -1

	_target_pool_size = _curriculum_target_pool_size(spawn_pool.size())
	arm.orientation_progress_weight = _curriculum_orientation_weight()
	var joint_jitter_degrees := 0.0

	var curriculum_episode := _curriculum_episode()
	if _has_adaptive_curriculum():
		joint_jitter_degrees = _apply_adaptive_pose_curriculum()
	else:
		joint_jitter_degrees = _apply_episode_pose_curriculum(
			curriculum_episode)

	var regular_reset_fraction := _bootstrap_curriculum_fraction()
	var use_regular_reset := _sample_regular_reset(_episode_rng)
	if not use_regular_reset and not bootstrap_pose_joints.is_empty():
		_active_bootstrap_index = _sample_bootstrap_index(_episode_rng)
	# A bootstrap reset places the arm at a pre-grasp pose built for ITS own target, which would
	# quietly ignore the pinned one.
	if _has_fixed_target:
		use_regular_reset = true
	var sampled_target := _sample_target_transform(_episode_rng, spawn_pool)
	if per_region_gate_enabled and use_regular_reset:
		_apply_per_region_gate(str(_last_target_sample_info.get("target_region", "")))
	var sample_info := _last_target_sample_info.duplicate(true)
	if not use_regular_reset:
		sample_info = {
			"target_sampling": "bootstrap",
			"target_region": "bootstrap",
			"target_cell": -1,
		}
	_last_reset_was_regular = use_regular_reset
	# TRAINING ONLY. A seeded episode starts above the bin with only the release left, so counting it
	# as an evaluation episode would report a success rate for a task nobody asked for -- and this
	# project has already been burned once by an evaluation that measured something other than the
	# task (eval running at maximum difficulty regardless of the curriculum). The seed is a teaching
	# aid; the number reported has to stay the real thing.
	_transport_seeded_episode = (
		_training_mode
		and transport_enabled
		and not transport_seed_pose_joints.is_empty()
		and _episode_rng.randf() < _transport_seed_fraction())
	var reset_info := {
		"task_reset_mode": "regular" if use_regular_reset else "bootstrap",
		"regular_reset": use_regular_reset,
		"regular_reset_fraction": regular_reset_fraction,
		"curriculum_level": _curriculum_level_override,
		"curriculum_episode": curriculum_episode,
	}
	reset_info.merge(sample_info, true)
	controller.merge_agent_reset_info(arm, reset_info)
	_place_target(_sample_reset_target_transform(
		sampled_target, _episode_rng, use_regular_reset))
	arm.set_reset_joint_offsets(_sample_reset_joint_offsets(
		_episode_rng, joint_jitter_degrees, use_regular_reset))


## Apply a sampled pose to the target.
func _place_target(pose: Transform3D) -> void:
	if grasp_target == null:
		target.global_transform = pose
		return

	# A new episode cannot start still holding the previous one's object.
	if arm != null and arm.has_method("is_grasp_attached") and arm.is_grasp_attached():
		_release_object()

	var origin := pose.origin
	if _grasp_calibrated:
		origin.y = _support_top_y + _object_base_offset
	var resting := Transform3D(Basis.IDENTITY, origin)
	_grasp_spawn_position = origin
	_grasp_resting_transform = resting
	_has_grasp_resting_transform = true
	_object_tipped = false
	_collision_event_fired = false
	_reset_transport_phase()
	# Use the physics server so reset observations see the new pose immediately.
	var rid := grasp_target.get_rid()
	PhysicsServer3D.body_set_state(rid, PhysicsServer3D.BODY_STATE_TRANSFORM, resting)
	PhysicsServer3D.body_set_state(
		rid, PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY, Vector3.ZERO)
	PhysicsServer3D.body_set_state(
		rid, PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY, Vector3.ZERO)
	grasp_target.global_transform = resting
	grasp_target.linear_velocity = Vector3.ZERO
	grasp_target.angular_velocity = Vector3.ZERO

	_grasp_pose_basis = pose.basis.orthonormalized()
	_grasp_demanded_position = grasp_target_pose.global_position if grasp_target_pose != null else origin
	_grasp_pose_basis_valid = true
	_refresh_grasp_pose_basis()


## Hold the demanded grasp orientation fixed in WORLD space for the whole episode.
func _refresh_grasp_pose_basis() -> void:
	if not _grasp_pose_basis_valid:
		return
	# The marker inside the glass keeps the demanded ORIENTATION even if the object is knocked
	# askew, so the capture test is not measured against a rotated goal.
	if grasp_target_pose != null:
		grasp_target_pose.global_basis = _grasp_pose_basis
	if _demanded_pose == null:
		return
	# Without transport the demanded pose does not move at all for the whole episode: that task is a
	# grasp IN PLACE, and carrying the glass elsewhere has to register as leaving the target.
	if not transport_enabled:
		_demanded_pose.global_transform = Transform3D(
			_grasp_pose_basis, _grasp_demanded_position)
		return
	_demanded_pose.global_transform = _phase_waypoint()


## Where the arm is being sent right now. This is the whole of the phase machine's effect on the
## agent: one marker, moved.
func _phase_waypoint() -> Transform3D:
	match _transport_phase:
		TransportPhase.LIFT:
			return Transform3D(
				_grasp_pose_basis,
				_grasp_demanded_position + Vector3.UP * transport_lift_height)
		TransportPhase.CARRY:
			return Transform3D(_grasp_pose_basis, _release_point)
		TransportPhase.HOME:
			# Falls back to the grasp point if home was never measured. Unreachable in practice --
			# HOME follows a delivery, which follows a reset -- but a silent Transform3D.IDENTITY
			# would send the arm to the world origin, inside its own base.
			return _home_tool_transform if _home_tool_valid else Transform3D(
				_grasp_pose_basis, _grasp_demanded_position)
		_:
			return Transform3D(_grasp_pose_basis, _grasp_demanded_position)


## Phase transitions, evaluated once per physics frame.
##
## Every gate here is a MEASURED condition, never a step count: the arm advances when it has
## actually arrived, and the drop is judged by the glass being inside the bin area rather than by
## the arm having been in roughly the right place when it opened.
## Success must be UNREACHABLE until the glass is delivered.
##
## The arm's success machine watches the demanded pose, and during CARRY that pose is the release
## point -- which the arm reaches while still HOLDING the glass. It then satisfies distance,
## orientation, stillness and the grasp requirement at once and the episode ends there with the full
## goal reward: measured live as +60 episodes with progress 1.000, paying the policy for carrying and
## never letting go, which is exactly what looked wrong on screen. Guarding the lift waypoint with a
## looser tolerance did not cover this, because CARRY deliberately does not advance on arrival.
##
## Raising the hold requirement out of reach suppresses success without touching the shared agent or
## inventing a second success rule. It runs EVERY FRAME rather than once per reset because the hold
## curriculum rewrites the same property (see `_apply_adaptive_hold_curriculum`), and it captures
## whatever value it finds that is not the sentinel -- so the curriculum's choice is preserved and
## handed back at delivery instead of being clobbered by a value read at _ready.
func _suppress_success_until_delivered() -> void:
	var current := int(arm.success_hold_physics_frames)
	if current != SUCCESS_SUPPRESSED_FRAMES:
		_home_success_hold_frames = current
	arm.success_hold_physics_frames = SUCCESS_SUPPRESSED_FRAMES


func _advance_transport_phase() -> void:
	if not transport_enabled or arm == null or grasp_target == null:
		return
	if not _object_delivered:
		_suppress_success_until_delivered()
	var attached: bool = arm.has_method("is_grasp_attached") and arm.is_grasp_attached()
	if transport_release_debug:
		var tool_now: Node3D = arm.tool_pose
		if _transport_phase == TransportPhase.CARRY and tool_now != null and _release_point_valid:
			var d := tool_now.global_position.distance_to(_release_point)
			if d < _carry_closest:
				_carry_closest = d
		if _transport_phase != _debug_last_phase:
			print("[fase] %d -> %d  (piu' vicino al cestino finora %.3f m)" % [
				_debug_last_phase, _transport_phase, _carry_closest])
			_debug_last_phase = _transport_phase
	# Fumbling the glass is a failure, not a free retry.
	#
	# "Dropped" only existed in LIFT and CARRY, so an object captured during the approach and then
	# lost produced no event at all: the tilt check is the only other thing that could end the
	# episode and it fires solely past 75 degrees, so a glass that fell, slid and stayed upright left
	# the episode running while the arm went on collecting approach shaping for a task it had already
	# lost. Reported from the render by the user, who watched one slide across the table and into the
	# bin with the episode still going.
	#
	# Judged as a spill directly rather than through the drop window: a glass let go before the
	# transport ever started has not been delivered, and letting the window decide would credit a
	# lucky bounce into the bin as a delivery.
	if _was_attached and not attached and _transport_phase == TransportPhase.GRASP:
		_was_attached = false
		if not _object_spilled and not _object_delivered:
			_object_spilled = true
			if spilled_event != null:
				spilled_event.trigger(str(arm.name))
		return
	_was_attached = attached
	match _transport_phase:
		TransportPhase.GRASP:
			if attached:
				_rebaseline_stall_guard()
				# A seeded episode already stands over the bin, so the lift waypoint -- the grasp
				# point plus 15 cm -- would send it back to the table it never came from.
				_transport_phase = (
					TransportPhase.CARRY if _transport_seeded_episode else TransportPhase.LIFT)
		TransportPhase.LIFT:
			if not attached:
				_on_glass_released()
			elif _tool_reached(_phase_waypoint().origin):
				_transport_phase = TransportPhase.CARRY
				_rebaseline_stall_guard()
		TransportPhase.CARRY:
			if not attached:
				_on_glass_released()
		TransportPhase.HOME:
			pass


## The glass has left the hand. Whether that was a delivery or a spill is decided by where it ends
## up, not by where the arm was: a release directly above the opening can still bounce out.
## The phase does NOT advance here -- it advances when the drop is judged.
##
## Switching to HOME on the release was tried and did two kinds of damage. The demanded pose jumped
## half a metre, so the arm left at full joint speed and FLUNG the glass, which after the release
## still rests on the fingers (6-27 mm below the tool, outside the measured pad window, where
## kinematic fingers hold it indefinitely): spilled glasses turned up at y 0.69-0.81 moving at
## 0.2-0.5 m/s, thrown clear of the bin. Worse, `get_release_incentive` is gated to the CARRY phase,
## so leaving CARRY switched off the only gradient that pays for opening WIDER -- exactly when wider
## is what frees the glass. Measured at the release the gap is 42-47 mm around a 40 mm glass: one or
## two millimetres a side, too tight to fall through cleanly.
##
## Staying in CARRY until the verdict keeps the arm still and keeps paying for a wider opening.
func _on_glass_released() -> void:
	# Armed on the TRANSITION, not on the state. The carry phase calls this every frame the object is
	# not attached, and re-arming each time pushed the deadline forward one frame at a time, so it
	# never arrived: a glass dropped on the floor left `_drop_pending` true forever and the spill was
	# never registered -- the miss was unpunished, and only the delivery path could ever fire.
	if _drop_pending or _object_delivered or _object_spilled:
		return
	_drop_pending = true
	_frames_stuck_in_claws = 0
	_frames_since_release = 0
	_drop_deadline_frame = Engine.get_physics_frames() + maxi(transport_drop_grace_frames, 1)
	if transport_release_debug and arm.tool_pose != null and _release_point_valid:
		var tool: Node3D = arm.tool_pose
		print("[rilascio] fase=%d seme=%s passo=%d  distanza dal cestino %.3f m  altezza mano %.3f" % [
			_transport_phase, str(_transport_seeded_episode), controller.step_count,
			tool.global_position.distance_to(_release_point), tool.global_position.y])


## Judge a pending drop. Runs every frame while one is outstanding.
func _resolve_pending_drop() -> void:
	if not _drop_pending:
		return
	if transport_drop_area != null and transport_drop_area.overlaps_body(grasp_target):
		if transport_release_debug:
			print("[esito] CONSEGNATO trattenuto %d frame, bicchiere (%.3f, %.3f, %.3f)" % [
				_frames_stuck_in_claws,
				grasp_target.global_position.x, grasp_target.global_position.y,
				grasp_target.global_position.z])
		_drop_pending = false
		_object_delivered = true
		_transport_phase = TransportPhase.HOME
		_rebaseline_stall_guard()
		# The way home is the only leg that does not need the glass, so the grasp requirement that
		# guards every earlier phase against a premature success is lifted exactly here.
		arm.success_requires_grasp = false
		if _home_success_hold_frames > 0:
			arm.success_hold_physics_frames = _home_success_hold_frames
		if delivered_event != null:
			delivered_event.trigger(str(arm.name))
		return
	# The clock must measure the FALL, not the command to open. Declaring the release when the gap
	# exceeds the glass by 5 mm leaves it resting on the pads: it only slips free when the hand moves,
	# up to two seconds later, and the spill verdict then landed while the glass was still on its way
	# into the bin -- caught by the velocity, 0.2-0.4 m/s, which is a glass that has been falling for
	# a fortieth of a second, not for the two seconds the deadline had counted. While the object is
	# still between the pads it has not been dropped, so the window has not started.
	if transport_release_debug and (_frames_since_release % 20) == 0:
		print("[volo] +%3d frame  bicchiere y=%.3f  v=%.3f  fra i pad=%s  varco=%.4f  attaccato=%s" % [
			_frames_since_release, grasp_target.global_position.y,
			grasp_target.linear_velocity.length(),
			str(arm.call("is_object_between_pads")), float(arm.call("pad_gap")),
			str(arm.is_grasp_attached())])
	_frames_since_release += 1
	if arm.has_method("is_object_between_pads") and bool(arm.call("is_object_between_pads")):
		_frames_since_release = 0
		_frames_stuck_in_claws += 1
		return
	# Counted in frames THIS SCENARIO PROCESSED, never in `Engine.get_physics_frames()`.
	#
	# Under lockstep the scene tree is PAUSED between commands while the engine's frame counter keeps
	# running, so a deadline expressed in engine frames expires after a handful of frames the
	# scenario actually saw: measured 58 releases of which 58 were still within 20 processed frames
	# and only 2 ever reached 20. Every spill verdict was therefore reached while the glass was still
	# in the air, which is why widening the release, cancelling on re-capture and holding the arm
	# still each failed to move the delivery count.
	if _frames_since_release >= maxi(transport_drop_grace_frames, 1):
		if transport_release_debug:
			var tool_y: float = (arm.tool_pose as Node3D).global_position.y if arm.tool_pose != null else -1.0
			print("[esito] VERSATO trattenuto %d frame a (%.3f, %.3f, %.3f)  velocita %.4f  sotto la mano %.3f  varco %.4f" % [
				_frames_stuck_in_claws,
				grasp_target.global_position.x, grasp_target.global_position.y,
				grasp_target.global_position.z,
				grasp_target.linear_velocity.length(),
				tool_y - grasp_target.global_position.y, float(arm.call("pad_gap"))])
		_drop_pending = false
		_object_spilled = true
		_transport_phase = TransportPhase.HOME
		if spilled_event != null:
			spilled_event.trigger(str(arm.name))


## Dense incentive to OPEN the claws, in [0, 1], and only where opening is the right move.
##
## Why this term has to exist. Warm-starting from the grasp actor transfers more than expected: the
## actor knows "go to the demanded pose", and since a phase IS the demanded pose moved, lift and
## carry come for free -- watched live on the first episodes, which reach the bin almost cleanly.
## But opening is not going anywhere. It is the one action dimension that had a single correct
## direction throughout the grasp task, and the actor learned it pinned shut. The +25 for delivery
## only pays AFTER the release, so nothing gradient-shaped leads there: the policy would have to
## stumble on it by exploration, at alpha 0.03.
##
## This is the mirror image of the "never closes" trap the plan warned about, and it gets the same
## treatment -- a dense term, tightly gated so it cannot be farmed:
##
##   only during CARRY, the one phase where letting go is the goal
##   only within `transport_release_incentive_radius` of the release point, fading with distance
##   rather than switching on, so it cannot pay for opening anywhere else
##   measured on `pad_gap`, which is `pad_gap_closed + 2q` and therefore monotone in the travel by
##   construction -- the reward cannot have a local maximum the policy could park on
##
## Two shapes were rejected by the probe before this one, and both failures are worth keeping:
## scaling by the RELEASE THRESHOLD made the term read 0.74 with the claws still shut, a flat bonus
## rather than a gradient; and gating on `is_grasp_attached()` drove it to zero at the exact instant
## the release succeeded, so the gradient pointed at "almost open" and then fell off a cliff. The
## span here is a full opening, well past the release point, so the reward is still rising as the
## glass leaves the hand.
func get_release_incentive() -> float:
	if not transport_enabled or arm == null or _transport_phase != TransportPhase.CARRY:
		return 0.0
	var tool: Node3D = arm.tool_pose
	if tool == null or not _release_point_valid:
		return 0.0
	var radius := maxf(transport_release_incentive_radius, 0.001)
	var distance := tool.global_position.distance_to(_release_point)
	var open_span := maxf(transport_release_open_span, 0.001)
	if distance >= radius:
		# AWAY from the bin, holding the object: being open has to COST.
		#
		# Outside the radius this returned zero, so opening en route was free in the moment and paid
		# for only at the end, by a spill penalty a hundred discounted steps away -- while nothing at
		# all rewarded holding on, the +15 for the grasp being banked once and never renewed. So the
		# gripper had no gradient during transport. Measured over 1155 releases in real (non-seeded)
		# episodes: 1% happened within 10 cm of the release point, median distance 28 cm. The arm let
		# go almost everywhere except above the bin.
		if not (arm.has_method("is_grasp_attached") and arm.is_grasp_attached()):
			return 0.0
		var ajar: float = float(arm.call("pad_gap")) - float(arm.grasp_object_width)
		return -clampf(ajar / open_span, 0.0, 1.0)
	var nearness := 1.0 - distance / radius
	var span := open_span
	var opened: float = float(arm.call("pad_gap")) - float(arm.grasp_object_width)
	# Spans [-1, +1], not [0, 1]: holding on over the bin has to COST.
	#
	# A one-sided incentive can only ever add, so hovering at the release point with the claws shut
	# was free -- and it is not merely free, it PAYS, because the arm has reached the demanded pose
	# and collects pose-tracking, proximity and stillness every step. Watched live: an episode
	# standing over the open bin, glass in hand, at +33 and climbing, roughly 0.16 a step. Over the
	# ~160 steps left that is worth about as much as the +25 for delivering, with none of the risk.
	# Camping was a local optimum exactly as good as finishing the task.
	return nearness * (2.0 * clampf(opened / span, 0.0, 1.0) - 1.0)


func _tool_reached(point: Vector3) -> bool:
	var tool: Node3D = arm.tool_pose if arm != null else null
	if tool == null:
		return false
	return tool.global_position.distance_to(point) <= maxf(transport_waypoint_distance, 0.001)


func _reset_transport_phase() -> void:
	if transport_release_debug and _drop_pending:
		print("[esito] EPISODIO FINITO A META' VOLO: il bicchiere era (%.3f, %.3f, %.3f), mai giudicato" % [
			grasp_target.global_position.x, grasp_target.global_position.y,
			grasp_target.global_position.z] if grasp_target != null else "")
	_transport_phase = TransportPhase.GRASP
	_was_attached = false
	_object_grasped_this_episode = false
	_debug_last_phase = 0
	_carry_closest = 99.0
	_drop_pending = false
	_drop_deadline_frame = 0
	_object_delivered = false
	_object_spilled = false
	if transport_enabled and arm != null:
		# Restored every episode: `_resolve_pending_drop` clears it on delivery, and an episode that
		# ended after a delivery would otherwise start the next one able to succeed empty-handed.
		arm.success_requires_grasp = true
		# Hand the real requirement back BEFORE clearing the shadow. Without this the sentinel
		# survives from one episode to the next, `_suppress_success_until_delivered` only ever sees
		# the sentinel, never captures a real value, and the restore at delivery silently does
		# nothing -- leaving success unreachable even on the way home.
		if _home_success_hold_frames > 0:
			arm.success_hold_physics_frames = _home_success_hold_frames
		_home_success_hold_frames = -1


## Release point over the bin, derived from the bin's own geometry rather than written down.
##
## The bin is a CSGBox3D hollowed by a subtracted child, so the OPENING is the subtracted box and
## the RIM is the top of the outer one. Reading both means moving the bin in the editor moves the
## release point with it, which is the same rule the table and the glass already follow.
func _compute_release_point() -> void:
	_release_point = Vector3.ZERO
	_release_point_valid = false
	var zone := transport_drop_area.get_parent() if transport_drop_area != null else null
	if zone == null or not (zone is Node3D):
		return
	var outer: Variant = zone.get("size")
	if not (outer is Vector3):
		return
	var centre: Vector3 = (zone as Node3D).global_position
	var hollow := (zone as Node3D).get_node_or_null("CSGBox3D2")
	var inner: Vector3 = (hollow.get("size") as Vector3) if hollow != null else (outer as Vector3)
	var rim: float = centre.y + (outer as Vector3).y * 0.5
	_release_point = Vector3(centre.x, rim + transport_release_height, centre.z)
	_release_opening = Rect2(
		Vector2(centre.x - inner.x * 0.5, centre.z - inner.z * 0.5),
		Vector2(inner.x, inner.z))
	_release_point_valid = true


## Put the object back on its spawn once the arm has finished resetting.
##
## The reset order is: sample the target, place the object, THEN teleport the arm to its home pose.
## A kinematic link that teleports moves at effectively infinite speed, so an arm returning home
## across the table swats the glass -- measured at 662 mm in one case, which then read as a stalled
## episode with a large disturbance penalty the policy had done nothing to earn. Re-asserting the
## resting pose after the arm has settled is the same fix Breakout needed for its ball: place the
## object once the rest of the world has already reached its reset state, not before.
func _on_episode_reset_completed(_seed: int) -> void:
	_capture_home_tool_transform()
	if _apply_transport_seed():
		return
	if grasp_target == null or not _has_grasp_resting_transform:
		return
	if arm != null and arm.has_method("is_grasp_attached") and arm.is_grasp_attached():
		return
	var rid := grasp_target.get_rid()
	PhysicsServer3D.body_set_state(
		rid, PhysicsServer3D.BODY_STATE_TRANSFORM, _grasp_resting_transform)
	PhysicsServer3D.body_set_state(
		rid, PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY, Vector3.ZERO)
	PhysicsServer3D.body_set_state(
		rid, PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY, Vector3.ZERO)
	grasp_target.global_transform = _grasp_resting_transform
	grasp_target.linear_velocity = Vector3.ZERO
	grasp_target.angular_velocity = Vector3.ZERO
	# Redraw the debug overlays now. They live in _process, and in lockstep the tree is PAUSED
	# between commands -- this callback fires after the reset's last idle frame, so without an
	# explicit refresh the gizmo and height ray sit at the pre-reset pose until the next env step.
	# After an episode that ended holding the glass, that leaves the target marker hanging off the
	# hand while the glass is back on the table: the render is then actively misleading, which
	# defeats the point of watching it.
	_refresh_debug_overlays()


## Assisted grasp. The arm runs in KINEMATIC mode, where every link is frozen and re-posed from
## forward kinematics each frame: the fingers can PUSH a rigid body but never receive a reaction,
## so friction can never hold anything. Holding therefore has to be declared rather than simulated.
##
## Everything about WHEN to declare it is measured, not assumed: the window comes from the pad faces,
## the fit from the calibrated pad gap. Switching to a real frictional grasp under PHYSICS_MOTORS
## means replacing this one function with a contact test -- nothing else in the scenario reads the
## capture rule directly, which is the point of keeping it behind a single call.
func _update_grasp_capture() -> void:
	if grasp_target == null or arm == null or not arm.has_method("grasp_window"):
		return
	if arm.is_grasp_attached():
		_hold_captured_object()
		if _should_release():
			_release_object()
		return
	if _grasp_capture_condition():
		_capture_object()


func _grasp_capture_condition() -> bool:
	var window: Dictionary = arm.call("grasp_window")
	if window.is_empty():
		return false
	# 1. The object sits inside the overlap of the two pad faces.
	var offset: Vector3 = arm.call("object_offset_in_tool")
	var slack := Vector3.ONE * maxf(grasp_capture_tolerance, 0.0)
	var lo: Vector3 = (window["min"] as Vector3) - slack
	var hi: Vector3 = (window["max"] as Vector3) + slack
	for component in range(3):
		if offset[component] < lo[component] or offset[component] > hi[component]:
			return false
	# 2. The claws have CLOSED ONTO the object -- a crossing, not a window.
	#
	# Requiring |gap - width| below a tolerance looked right and is unusable: the gripper runs at
	# 0.5 m/s, so the gap shrinks about 17 mm per physics frame and a 4 mm window is stepped over
	# between two evaluations. Capture would then depend on the frame rate, which is exactly the
	# class of hidden coupling strict_physics_frames exists to remove.
	#
	# Closing FURTHER does not cancel the grasp. A kinematic finger cannot be stopped by contact, so
	# it always ends up inside the object; that squeeze is real and is paid for by the penetration
	# penalty, but once the pads have reached the object it is held.
	var fit_error: float = float(arm.call("pad_gap")) - float(arm.grasp_object_width)
	if fit_error > maxf(grasp_capture_gap_tolerance, 0.0):
		return false
	# 3. The object is at rest. One that is still moving has been knocked, not grasped.
	if grasp_target.linear_velocity.length() > maxf(grasp_capture_max_object_speed, 0.0):
		return false
	# 4. The object is genuinely BETWEEN the pads, by the strict measured window rather than the
	# slack-widened one used in step 1.
	#
	# Steps 1 and 2 alone paid out for a grasp the strict test rejected: an object just outside the
	# pad faces still fell inside the widened window, and closing further never cancels a capture, so
	# clamping shut and driving in collected the terminal reward. Measured at episode 5200, six of
	# ten home "grasps" had the pads at 17-21 mm on a 40 mm glass with the object never between them.
	# The contact stop is deliberately permissive so this state is now hard to reach at all; this
	# makes it unrewarded even if it is.
	if arm.has_method("is_object_between_pads") and not arm.call("is_object_between_pads"):
		return false
	return true


## Let go once the claws open clear of the object. The inverse of condition 2, with a margin so a
## grasp sitting exactly on the fit threshold does not chatter between held and dropped.
func _should_release() -> bool:
	var fit_error: float = float(arm.call("pad_gap")) - float(arm.grasp_object_width)
	return fit_error > maxf(grasp_capture_gap_tolerance, 0.0) + maxf(grasp_release_clearance, 0.0)


func _capture_object() -> void:
	var tool: Node3D = arm.tool_pose
	if tool == null:
		return
	_grasp_attach_transform = tool.global_transform.affine_inverse() * grasp_target.global_transform
	_grasp_object_frozen_before = grasp_target.freeze
	grasp_target.freeze_mode = RigidBody3D.FREEZE_MODE_KINEMATIC
	grasp_target.freeze = true
	arm.set_grasp_attached(true)
	# Taking the glass back cancels any drop still being judged.
	#
	# The grasp chatters around the release threshold -- pad gap sitting at 44.5-46.1 mm against a
	# 45.0 mm threshold -- so a momentary loss armed the grace clock while the glass stayed in the
	# hand. By the time it was really let go the deadline had passed, and the drop was declared
	# spilled WHILE THE GLASS WAS STILL FALLING INTO THE BIN: 27 of 32 spills had the glass over the
	# opening at 0.33-0.38 m, moving at 0.2-0.5 m/s. The clock has to measure the last release, not
	# the first flicker.
	_drop_pending = false
	_hold_captured_object()
	# Pay for the capture itself.
	#
	# In the grasp-only task the capture WAS the success and collected the goal reward. Suppressing
	# success until delivery removed that payoff and left the gripper with nothing but costs --
	# premature closure and penetration -- so staying open became the safe local optimum and the
	# policy stopped closing: measured as the minimum pad gap DRIFTING UP across training, 43.1 mm to
	# 46.0 mm against a 40.0 mm glass, with the object between the pads and the close commanded in
	# 11-14 of 20 episodes but never completed. A chain pays for every link or only the last one
	# survives.
	if transport_enabled and not _object_grasped_this_episode and grasped_event != null:
		_object_grasped_this_episode = true
		grasped_event.trigger(str(arm.name))


func _release_object() -> void:
	grasp_target.freeze = _grasp_object_frozen_before
	arm.set_grasp_attached(false)


## Replay the captured relative pose. Same mechanism the arm already uses for its own links under
## kinematic control: the body is frozen and written from a parent frame every physics frame.
func _hold_captured_object() -> void:
	var tool: Node3D = arm.tool_pose
	if tool == null:
		return
	var pose := tool.global_transform * _grasp_attach_transform
	PhysicsServer3D.body_set_state(
		grasp_target.get_rid(), PhysicsServer3D.BODY_STATE_TRANSFORM, pose)
	grasp_target.global_transform = pose


## How far the object has been pushed from where it was placed, in metres. The horizontal part is
## the disturbance v1 penalises; the vertical part becomes the lift height in v2, which is why it is
## measured here rather than folded into a single scalar.
func grasp_object_displacement() -> Vector3:
	if grasp_target == null:
		return Vector3.ZERO
	return grasp_target.global_position - _grasp_spawn_position


## How far the object has been tipped off vertical, in degrees.
func grasp_object_tilt_degrees() -> float:
	if grasp_target == null:
		return 0.0
	return rad_to_deg(
		grasp_target.global_basis.orthonormalized().y.angle_to(Vector3.UP))


## Fire the terminal event the first time the object goes over. Measured with
## tools/local/openarm_glass_tipping_probe.gd: a lateral miss of 20 mm or more lays the glass down at
## 83-87 degrees, and the displacement penalty is already SATURATED there (spawn offsets of 57-115 mm
## against a 20 mm scale), so a nudge and a topple cost exactly the same. This is what separates them.
func _check_object_tipped() -> void:
	if (
		not terminate_on_tipped_object
		or grasp_target == null
		or _object_tipped
		or tipped_event == null
	):
		return
	# Tilt only matters while the glass is STANDING ON THE TABLE, where a knock makes it ungraspable
	# and the episode unwinnable. Once it is in the hand the arm may tilt it as it likes, and once it
	# has been let go the only question is where it lands: delivery asks that the glass FALL INTO the
	# bin, not that it be set down neatly. A glass 80 mm tall on a 40 mm base, dropped 385 mm to the
	# bin floor, topples essentially every time -- so terminating on tilt made a correct delivery
	# indistinguishable from a failure, and `object_tipped` was ending 22% of episodes. A drop that
	# misses is still punished, by the spill path.
	if _drop_pending or _object_delivered:
		return
	if arm != null and arm.has_method("is_grasp_attached") and arm.is_grasp_attached():
		return
	if grasp_object_tilt_degrees() <= maxf(grasp_tip_degrees, 0.0):
		return
	_object_tipped = true
	if transport_release_debug:
		print("[ribaltato] fase=%d attaccato=%s pendente=%s consegnato=%s inclinazione %.1f gradi altezza %.3f" % [
			_transport_phase,
			str(arm.has_method("is_grasp_attached") and arm.is_grasp_attached()),
			str(_drop_pending), str(_object_delivered),
			grasp_object_tilt_degrees(), grasp_target.global_position.y])
	tipped_event.trigger(str(arm.name))


## Per-step penalty in [-1, 0] for having moved the object off its spawn. Horizontal only, and zero
## once the object is held: after a capture the arm is SUPPOSED to move it, and charging for that
## would make a successful grasp cost more the better it goes.
##
## Reported as a state, not a delta. A delta would let the arm knock the glass and then be paid back
## for nudging it home, and it would fall silent while the glass slid at a constant offset. The
## penalty accumulating every step is the point: displacement is a mistake that stays made.
func get_grasp_disturbance_penalty() -> float:
	if grasp_target == null or (arm != null and arm.is_grasp_attached()):
		return 0.0
	var displacement := grasp_object_displacement()
	var horizontal := Vector2(displacement.x, displacement.z).length()
	return -clampf(horizontal / maxf(grasp_disturbance_scale, 0.0001), 0.0, 1.0)


## Per-step penalty in [-1, 0] for the pads being INSIDE the object.
##
## In kinematic control the fingers cannot be stopped by contact -- they pass straight through a
## rigid body -- so "do not squeeze too hard" has no physical consequence to learn from and has to be
## modelled. The depth itself is exact, though: it is the calibrated pad gap against the measured
## object width. This is the one place in the task where a model stands in for physics, and it is
## the first thing to revisit under PHYSICS_MOTORS.
func get_grasp_penetration_penalty() -> float:
	if arm == null or not arm.has_method("grasp_penetration"):
		return 0.0
	# Billed only while CLOSING, never while carrying.
	#
	# Once the object is held the claws stay where they are, so the depth is CONSTANT -- and charging
	# it every step of the transport turns a single decision into a running tax whose only remedy is
	# to open the hand. At weight 0.5 over a hundred-step carry that is worth about -50, twice the
	# +25 for delivering: the arm was being paid to let go on the way to the bin, which is exactly
	# what it did. Measured over 815 releases, only 32% happened within 10 cm of the release point
	# and 142 came during the lift, right after grasping; the gap at release clustered just above the
	# 50 mm threshold, the signature of opening gradually rather than deliberately.
	#
	# The term exists to shape how hard the pads close, and closing is over once the grasp is made.
	if arm.has_method("is_grasp_attached") and arm.is_grasp_attached():
		return 0.0
	var depth: float = arm.call("grasp_penetration")
	return -clampf(depth / maxf(grasp_penetration_scale, 0.0001), 0.0, 1.0)


## Per-step cost in [-1, 0] for flying close to the arm's own body.
##
## Self-collision is terminal and therefore has NO GRADIENT: until the arm touches itself, being 30
## mm clear and being 2 mm clear earn exactly the same reward, so nothing ever pushes the policy off
## the boundary. Measured on the best checkpoint over 40 episodes: the minimum clearance was inside
## 20 mm in EVERY episode and inside 10 mm in seven of them -- the arm does not occasionally stray
## near itself, it lives there. That is why self-collisions can jump from 0 to 17 between two
## evaluations without any loss of skill: a trajectory already against the boundary needs only a
## millimetre of drift to cross it.
##
## Deliberately zero beyond the threshold. The Medium cells are the lateral ones, reachable only
## with the arm fairly folded, so a cost that reached everywhere would teach it to avoid the region
## instead of to pass through it carefully.
func get_self_proximity_penalty() -> float:
	if arm == null or not arm.has_method("self_body_clearance"):
		return 0.0
	var clearance: float = arm.call("self_body_clearance")
	if clearance < 0.0:
		return 0.0  # measurement disabled; charging a cost here would be inventing one
	var threshold := maxf(self_proximity_threshold, 0.0001)
	if clearance >= threshold:
		return 0.0
	return -clampf((threshold - clearance) / threshold, 0.0, 1.0)


## Per-step cost in [-1, 0] for carrying the claws narrower than the object while the object is not
## between them. Zero once it is, and zero while holding.
##
## This closes the mirror of the camping trap. Squeezing is only charged when the object is actually
## between the pads -- without that condition an approach that missed and then shut its claws
## collected -86.9 for crushing nothing, which taught the arm never to close at all. But the
## condition also makes shutting on empty air FREE, and it is the same action that earns the grasp
## when the object is there, so the policy learns "close" without learning "when": measured at
## episode 4000, 9 of 9 home starts spent an average 222 steps with the claws shut and the object
## never once between them. Below the object's width the glass can no longer enter, so from that
## step the episode is unwinnable -- and the arm arrives clenched and knocks the glass over instead
## of enclosing it.
##
## Charging the closure rather than the contact keeps "do not squeeze" and adds "arrive open",
## which is the requirement the task had from the start.
func get_premature_closure_penalty() -> float:
	if arm == null or not arm.has_method("pad_gap"):
		return 0.0
	if arm.has_method("is_grasp_attached") and arm.is_grasp_attached():
		return 0.0
	if arm.has_method("is_object_between_pads") and arm.call("is_object_between_pads"):
		return 0.0
	var width: float = float(arm.grasp_object_width)
	if width <= 0.0:
		return 0.0
	var shortfall: float = width - float(arm.call("pad_gap"))
	if shortfall <= 0.0:
		return 0.0
	return -clampf(shortfall / width, 0.0, 1.0)


## Override the position gate per region (called after the target region is sampled).
func _apply_per_region_gate(region: String) -> void:
	if use_discrete_stage_curriculum:
		var stage := _discrete_stage()
		if stage.has(region):
			var gate: Array = stage[region]
			arm.success_distance = float(gate[0])
			arm.success_angle_degrees = float(gate[1])
		return
	var level := _adaptive_level() if _has_adaptive_curriculum() else 1.0
	if region == "easy":
		if level < easy_gate_stage1_level:
			arm.success_distance = per_region_gate_loose
		elif level < easy_gate_stage2_level:
			arm.success_distance = per_region_gate_mid
		else:
			arm.success_distance = easy_success_distance
	elif region == "medium":
		if level < medium_gate_stage1_level:
			arm.success_distance = per_region_gate_loose
		elif level < medium_gate_stage2_level:
			arm.success_distance = per_region_gate_mid
		else:
			arm.success_distance = medium_success_distance
	elif region == "hard":
		arm.success_distance = hard_success_distance


func _curriculum_target_pool_size(total_targets:int) -> int:
	var total := maxi(total_targets, 1)
	var easy := clampi(easy_target_count, 1, total)
	if _has_adaptive_curriculum():
		var start_level := clampf(
			adaptive_target_pool_start_level, 0.0, 1.0)
		var full_level := clampf(
			adaptive_target_pool_full_level, start_level, 1.0)
		if full_level <= start_level:
			return total if _adaptive_level() >= full_level else easy
		var adaptive_fraction := clampf(
			(_adaptive_level() - start_level)
			/ (full_level - start_level),
			0.0,
			1.0)
		return clampi(
			roundi(lerpf(float(easy), float(total), adaptive_fraction)),
			easy,
			total)
	if target_pool_curriculum_full_episode <= target_pool_curriculum_start_episode:
		return total
	var fraction := clampf(
		float(_curriculum_episode() - target_pool_curriculum_start_episode)
		/ float(
			target_pool_curriculum_full_episode
			- target_pool_curriculum_start_episode),
		0.0, 1.0)
	return clampi(roundi(lerpf(float(easy), float(total), fraction)), easy, total)


func _curriculum_orientation_weight() -> float:
	if use_discrete_stage_curriculum:
		return 0.10
	if _has_adaptive_curriculum():
		return (
			clampf(orientation_progress_final_weight, 0.0, 1.0)
			if _adaptive_level() >= adaptive_orientation_stage_level
			else clampf(adaptive_orientation_initial_weight, 0.0, 1.0)
		)
	if (
		orientation_progress_curriculum_full_episode
		<= orientation_progress_curriculum_start_episode
	):
		return clampf(orientation_progress_final_weight, 0.0, 1.0)
	var fraction := clampf(
		float(_curriculum_episode() - orientation_progress_curriculum_start_episode)
		/ float(
			orientation_progress_curriculum_full_episode
			- orientation_progress_curriculum_start_episode),
		0.0, 1.0)
	return lerpf(
		clampf(orientation_progress_start_weight, 0.0, 1.0),
		clampf(orientation_progress_final_weight, 0.0, 1.0),
		fraction)


func _has_bootstrap_pose() -> bool:
	if not bootstrap_pose_joints.is_empty():
		return true
	return bootstrap_target_pose != null and not bootstrap_joint_positions.is_empty()


func _bootstrap_curriculum_fraction() -> float:
	if not _has_bootstrap_pose():
		return 1.0
	if _has_adaptive_curriculum():
		var minimum := clampf(
			bootstrap_min_regular_reset_fraction, 0.0, 1.0)
		var full_level := clampf(
			adaptive_bootstrap_full_level, 0.0001, 1.0)
		var level_fraction := clampf(
			_adaptive_level() / full_level, 0.0, 1.0)
		# Episode pacing prevents a stalled promotion level from freezing the assist -- useful when
		# the level is merely slow, ruinous when the agent genuinely has not learned the stage yet.
		# Measured on the grasp: between episode 800 and 1900 the seeded share fell 80% -> 64% on
		# schedule while success AMONG SEEDED episodes fell 74% -> 48% and from-home success never
		# left zero. The assist was being taken away faster than the policy could replace it, and
		# because the formula takes max() the clock overrode the level that was standing still
		# precisely because nothing had been learned.
		if bootstrap_fade_follows_level:
			return lerpf(minimum, 1.0, level_fraction)
		var ep_start := bootstrap_curriculum_start_episode
		var ep_full := maxi(bootstrap_curriculum_full_episode, ep_start + 1)
		var ep_fraction := clampf(
			float(_training_episode - ep_start)
			/ float(ep_full - ep_start), 0.0, 1.0)
		return lerpf(minimum, 1.0, maxf(level_fraction, ep_fraction))
	if bootstrap_curriculum_full_episode <= bootstrap_curriculum_start_episode:
		return 1.0
	var fraction := clampf(
		float(_curriculum_episode() - bootstrap_curriculum_start_episode)
		/ float(
			bootstrap_curriculum_full_episode
			- bootstrap_curriculum_start_episode),
		0.0,
		1.0)
	# Keep some home-start practice even at the lowest curriculum level.
	return maxf(fraction, clampf(bootstrap_min_regular_reset_fraction, 0.0, 1.0))


func _has_adaptive_curriculum() -> bool:
	return _curriculum_level_override >= 0.0


func _adaptive_level() -> float:
	return clampf(_curriculum_level_override, 0.0, 1.0)


func _apply_adaptive_pose_curriculum() -> float:
	if use_discrete_stage_curriculum:
		var stage := _discrete_stage()
		arm.success_hold_physics_frames = maxi(int(stage["hold"]), 1)
		arm.success_max_joint_speed = maxf(float(stage["speed"]), 0.001)
		return 0.0
	var level := _adaptive_level()
	if level < adaptive_reach_stage1_level:
		arm.success_distance = adaptive_reach_stage_a_distance
		arm.success_angle_degrees = adaptive_reach_stage_a_angle
	elif level < adaptive_reach_stage2_level:
		arm.success_distance = 0.06
		arm.success_angle_degrees = 38.0
	elif level < adaptive_reach_stage3_level:
		arm.success_distance = 0.05
		arm.success_angle_degrees = 32.0
	else:
		arm.success_distance = 0.04
		arm.success_angle_degrees = 28.0

	# Tighten both hold duration and stillness as the curriculum advances.
	#
	# The first step used to go straight from Stage A to 40 frames at 0.05 -- four times the hold and
	# six times the stillness in one promotion. Measured twice on the grasp task: at the moment that
	# step lands, every episode fails on `stillness_gate` (20 of 20) while the grasp itself is
	# untouched (pad gap 39.6-39.9 mm on a 40 mm glass, position error 0.8 cm). The first time, with
	# no demotion configured, the policy sat at zero reward for 5600 episodes and unlearned the grasp
	# completely. Halving the step keeps each promotion survivable.
	if level < adaptive_reach_stage1_level:
		arm.success_hold_physics_frames = maxi(adaptive_hold_physics_frames, 1)
		arm.success_max_joint_speed = maxf(adaptive_hold_max_joint_speed, 0.001)
	elif level < adaptive_reach_stage2_level:
		arm.success_hold_physics_frames = 20
		arm.success_max_joint_speed = 0.12
	elif level < adaptive_reach_stage3_level:
		arm.success_hold_physics_frames = 40
		arm.success_max_joint_speed = 0.05
	else:
		arm.success_hold_physics_frames = 80
		arm.success_max_joint_speed = 0.04
	return 0.0


func _apply_episode_pose_curriculum(curriculum_episode:int) -> float:
	var joint_jitter_degrees := 0.0
	if curriculum_episode < reach_curriculum_stage1_until:
		arm.success_distance = 0.08
		arm.success_angle_degrees = 35.0
	elif curriculum_episode < reach_curriculum_stage2_until:
		arm.success_distance = 0.06
		arm.success_angle_degrees = 25.0
	elif curriculum_episode < reach_curriculum_stage3_until:
		joint_jitter_degrees = intermediate_joint_jitter_degrees
		arm.success_distance = 0.04
		arm.success_angle_degrees = 20.0
	else:
		joint_jitter_degrees = late_joint_jitter_degrees
		arm.success_distance = 0.02
		arm.success_angle_degrees = 20.0

	if curriculum_episode < hold_curriculum_stage1_until:
		arm.success_hold_physics_frames = 20
		arm.success_max_joint_speed = 0.10
	elif curriculum_episode < hold_curriculum_stage2_until:
		arm.success_hold_physics_frames = 60
		arm.success_max_joint_speed = 0.05
	else:
		arm.success_hold_physics_frames = 120
		arm.success_max_joint_speed = 0.02
	return joint_jitter_degrees


func _sample_regular_reset(rng: RandomNumberGenerator) -> bool:
	var fraction := _bootstrap_curriculum_fraction()
	return fraction >= 1.0 or (fraction > 0.0 and rng.randf() < fraction)


func _sample_reset_target_transform(
		sampled_target: Transform3D,
		rng: RandomNumberGenerator,
		use_regular_reset: bool) -> Transform3D:
	if use_regular_reset:
		return sampled_target

	var result: Transform3D
	if not bootstrap_pose_targets.is_empty():
		var idx := clampi(
			_active_bootstrap_index, 0, bootstrap_pose_targets.size() - 1)
		result = Transform3D(Basis.IDENTITY, bootstrap_pose_targets[idx])
	else:
		result = bootstrap_target_pose.global_transform
	var jitter_radius := maxf(bootstrap_target_jitter_radius, 0.0)
	if jitter_radius > 0.0:
		result.origin += Vector3(
			rng.randf_range(-jitter_radius, jitter_radius),
			rng.randf_range(-jitter_radius, jitter_radius),
			rng.randf_range(-jitter_radius, jitter_radius))
	# The bootstrap branch built its pose with an IDENTITY basis, which was right for reaching (the
	# demanded orientation was world identity everywhere) and is wrong for grasping, where it sweeps
	# with the target's azimuth. A seeded start whose demanded orientation differs from the one the
	# regular resets ask for would teach the assist a pose the evaluation never scores -- the arm
	# would be rehearsed on one wrist and graded on another.
	if grasp_target != null:
		result = _apply_target_orientation_randomization(rng, result)
	return result


func _sample_target_transform(
	rng: RandomNumberGenerator,
	spawn_pool: Array[Marker3D]) -> Transform3D:
	var target_index := rng.randi_range(
		0,
		maxi(mini(_target_pool_size, spawn_pool.size()) - 1, 0))
	var result := spawn_pool[target_index].global_transform
	if _should_sample_target_regions():
		var region := _select_target_region(rng)
		if region and region.has_method("sample_transform"):
			var forced_cell := _demo_forced_cell if _demo_mode else -1
			var sampled: Dictionary = region.call(
				"sample_transform", rng, result.basis, forced_cell)
			if sampled.get("valid", true) == false:
				push_error(
					"[openarm_scenario] region '%s' produced an invalid sample "
					% region.name
					+ "(broken allowlist/shape). Terminating (fail-closed).")
				get_tree().quit(1)
				return result
			var sampled_transform: Variant = sampled.get("transform")
			if sampled_transform is Transform3D:
				var sampled_region := str(sampled.get(
					"region", region.name)).strip_edges().to_lower()
				var sampled_cell := int(sampled.get("cell", -1))
				_last_target_sample_info = {
					"target_sampling": "stratified_region",
					"target_region": sampled_region,
					"target_cell": sampled_cell,
					# Stable identity used for trajectory-level train/validation splits.
					"target_pose_id": "%s:%d:%d" % [
						sampled_region, sampled_cell, _current_reset_seed],
					"target_coverage_cycle": int(sampled.get(
						"coverage_cycle", 0)),
					"target_coverage_fraction": float(sampled.get(
						"coverage_fraction", 0.0)),
				}
				var weights := _adaptive_region_weights()
				_last_target_sample_info["target_region_weights"] = [
					weights.x,
					weights.y,
					weights.z,
				]
				# Frozen evaluation treats a missing active region as failure.
				var active_names: Array = []
				for region_node in _active_regions():
					active_names.append(str(region_node.region_name).to_lower())
				_last_target_sample_info["active_regions"] = active_names
				result = sampled_transform
				return _apply_target_orientation_randomization(rng, result)

	_last_target_sample_info = {
		"target_sampling": "marker",
		"target_region": "marker",
		"target_cell": target_index,
	}
	if (
		continuous_target_sampling
		and _curriculum_episode() >= continuous_target_sampling_start_episode
	):
		result.origin = _sample_target_position(rng, spawn_pool, result.origin)
	return _apply_target_orientation_randomization(rng, result)


func _apply_target_orientation_randomization(
	rng: RandomNumberGenerator,
	target_transform: Transform3D
) -> Transform3D:
	var result := target_transform
	# Pinned first: the yaw below follows the target's azimuth, so it has to see the final position.
	if _has_fixed_target:
		result.origin = _fixed_target_position
	if target_yaw_follows_azimuth:
		result.basis = (
			Basis(Vector3.UP, _target_azimuth_yaw(result.origin)) * result.basis)
	if (
		target_yaw_randomization_degrees > 0.0
		and _curriculum_episode() >= target_yaw_randomization_start_episode
	):
		var yaw := deg_to_rad(rng.randf_range(
			-target_yaw_randomization_degrees,
			target_yaw_randomization_degrees))
		result.basis = Basis(Vector3.UP, yaw) * result.basis
	# Right multiplication applies pitch and roll in the yawed target frame.
	var pitch := target_pitch_degrees
	if target_pitch_randomization_degrees > 0.0:
		pitch += rng.randf_range(
			-target_pitch_randomization_degrees, target_pitch_randomization_degrees)
	pitch = clampf(pitch, 0.0, 90.0)
	if not is_zero_approx(pitch):
		result.basis = result.basis * Basis(Vector3.BACK, deg_to_rad(-pitch))
	if target_roll_randomization_degrees > 0.0:
		var roll := rng.randf_range(
			-target_roll_randomization_degrees, target_roll_randomization_degrees)
		result.basis = result.basis * Basis(Vector3.RIGHT, deg_to_rad(roll))
	return result


## Computes target-relative yaw around the arm base.
func _target_azimuth_yaw(target_position: Vector3) -> float:
	if arm == null:
		return 0.0
	var offset := target_position - (arm as Node3D).global_position
	if absf(offset.x) < 0.0001 and absf(offset.z) < 0.0001:
		return 0.0
	var azimuth := atan2(-offset.z, offset.x)
	var reference := deg_to_rad(target_azimuth_reference_degrees)
	return wrapf(azimuth - reference, -PI, PI) * target_azimuth_yaw_gain


func _should_sample_target_regions() -> bool:
	return (
		use_adaptive_target_regions
		and _has_adaptive_curriculum()
		and easy_target_region != null
		and easy_target_region.has_method("sample_transform"))


func _adaptive_region_weights() -> Vector3:
	if use_discrete_stage_curriculum:
		return _discrete_stage()["weights"]
	var level := _adaptive_level()
	var medium_start := clampf(
		adaptive_medium_region_start_level, 0.0, 1.0)
	var medium_full := clampf(
		adaptive_medium_region_full_level, medium_start, 1.0)
	var hard_start := clampf(
		adaptive_hard_region_start_level, medium_full, 1.0)
	var hard_full := clampf(
		adaptive_hard_region_full_level, hard_start, 1.0)

	if level < medium_start:
		return Vector3(1.0, 0.0, 0.0)
	if level < hard_start:
		var medium_fraction := lerpf(
			clampf(adaptive_medium_region_initial_weight, 0.0, 0.5),
			0.5,
			_range_fraction(level, medium_start, medium_full))
		return Vector3(1.0 - medium_fraction, medium_fraction, 0.0)

	var final_weights := _normalized_region_weights(
		adaptive_final_region_weights)
	var hard_fraction := _range_fraction(level, hard_start, hard_full)
	var hard_weight := lerpf(
		clampf(adaptive_hard_region_initial_weight, 0.0, 1.0),
		final_weights.z,
		hard_fraction)
	var remaining_weight := 1.0 - hard_weight
	var final_planar_weight := final_weights.x + final_weights.y
	var final_easy_ratio := (
		final_weights.x / final_planar_weight
		if final_planar_weight > 0.0
		else 0.5)
	var easy_ratio := lerpf(0.5, final_easy_ratio, hard_fraction)
	return _normalized_region_weights(Vector3(
		remaining_weight * easy_ratio,
		remaining_weight * (1.0 - easy_ratio),
		hard_weight))


func _range_fraction(value: float, start: float, end: float) -> float:
	if end <= start:
		return 1.0 if value >= end else 0.0
	return clampf((value - start) / (end - start), 0.0, 1.0)


## Discrete reach-hold curriculum: level -> stage index (0.0->A ..
func _stage_index_for_level(level: float) -> int:
	return clampi(int(round(level / 0.2)), 0, 5)


## Fixed stage settings for region weights, hold, speed and pose gates.
func _discrete_stage() -> Dictionary:
	var stages := [
		{"name": "A", "weights": Vector3(1, 0, 0), "hold": 20, "speed": 0.30,
			"easy": [0.04, 45.0], "medium": [0.04, 45.0], "hard": [0.04, 45.0]},
		{"name": "B", "weights": Vector3(1, 0, 0), "hold": 30, "speed": 0.25,
			"easy": [0.03, 30.0], "medium": [0.03, 30.0], "hard": [0.04, 30.0]},
		{"name": "C", "weights": Vector3(1, 0, 0), "hold": 60, "speed": 0.15,
			"easy": [0.02, 20.0], "medium": [0.03, 30.0], "hard": [0.04, 30.0]},
		{"name": "D", "weights": Vector3(0.5, 0.5, 0), "hold": 40, "speed": 0.20,
			"easy": [0.02, 20.0], "medium": [0.04, 45.0], "hard": [0.04, 30.0]},
		{"name": "E", "weights": Vector3(0.5, 0.5, 0), "hold": 60, "speed": 0.15,
			"easy": [0.02, 20.0], "medium": [0.03, 30.0], "hard": [0.04, 30.0]},
		{"name": "F", "weights": Vector3(0.2, 0.4, 0.4), "hold": 60, "speed": 0.15,
			"easy": [0.02, 20.0], "medium": [0.03, 30.0], "hard": [0.04, 30.0]},
	]
	var idx := _stage_index_for_level(_adaptive_level())
	var stage: Dictionary = stages[idx]
	stage["index"] = idx
	return stage


func _normalized_region_weights(weights: Vector3) -> Vector3:
	var clean := Vector3(
		maxf(weights.x, 0.0) if easy_target_region else 0.0,
		maxf(weights.y, 0.0) if medium_target_region else 0.0,
		maxf(weights.z, 0.0) if hard_target_region else 0.0)
	var total := clean.x + clean.y + clean.z
	if total <= 0.0:
		return Vector3(1.0, 0.0, 0.0)
	return clean / total


## Active (training-weighted) regions for the current stage, in fixed easy/medium/hard order.
func _active_regions() -> Array:
	var w := _adaptive_region_weights()
	var out: Array = []
	if easy_target_region and w.x > 0.0 and easy_target_region.has_method("sample_transform"):
		out.append(easy_target_region)
	if medium_target_region and w.y > 0.0 and medium_target_region.has_method("sample_transform"):
		out.append(medium_target_region)
	if hard_target_region and w.z > 0.0 and hard_target_region.has_method("sample_transform"):
		out.append(hard_target_region)
	return out


## Builds a balanced, seed-shuffled deck across active evaluation regions.
func _select_eval_region(rng: RandomNumberGenerator) -> Area3D:
	var active := _active_regions()
	if active.is_empty():
		return null
	if _eval_region_deck_index >= _eval_region_deck.size():
		_eval_region_deck = active.duplicate()
		for i in range(_eval_region_deck.size() - 1, 0, -1):
			var j := rng.randi_range(0, i)
			var tmp = _eval_region_deck[i]
			_eval_region_deck[i] = _eval_region_deck[j]
			_eval_region_deck[j] = tmp
		_eval_region_deck_index = 0
	var region: Area3D = _eval_region_deck[_eval_region_deck_index]
	_eval_region_deck_index += 1
	return region


func _demo_region() -> Area3D:
	match _demo_forced_region:
		"medium":
			return medium_target_region
		"hard":
			return hard_target_region
		_:
			return easy_target_region


func _select_target_region(rng: RandomNumberGenerator) -> Area3D:
	if _demo_mode:
		return _demo_region()
	if _evaluation_mode:
		return _select_eval_region(rng)
	var weights := _normalized_region_weights(_adaptive_region_weights())
	var candidates: Array[Area3D] = []
	var candidate_weights: Array[float] = []
	for entry in [
		[easy_target_region, weights.x],
		[medium_target_region, weights.y],
		[hard_target_region, weights.z],
	]:
		var region := entry[0] as Area3D
		var weight := float(entry[1])
		if region and weight > 0.0 and region.has_method("sample_transform"):
			candidates.append(region)
			candidate_weights.append(weight)
	if candidates.is_empty():
		return null

	var signature_parts: Array[String] = []
	for index in range(candidates.size()):
		signature_parts.append(
			"%d:%.5f" % [
				candidates[index].get_instance_id(),
				candidate_weights[index],
			])
	var signature := "|".join(signature_parts)
	if (
		_region_schedule_signature != signature
		or _region_schedule_cursor >= _region_schedule.size()
	):
		_build_region_schedule(
			rng, candidates, candidate_weights, signature)
	var selected := _region_schedule[_region_schedule_cursor]
	_region_schedule_cursor += 1
	return selected


func _build_region_schedule(
	rng: RandomNumberGenerator,
	candidates: Array[Area3D],
	weights: Array[float],
	signature: String
) -> void:
	_region_schedule.clear()
	_region_schedule_cursor = 0
	_region_schedule_signature = signature
	var schedule_size := maxi(target_region_schedule_size, candidates.size())
	var total_weight := 0.0
	for weight in weights:
		total_weight += weight
	var counts: Array[int] = []
	var remainders: Array[float] = []
	var assigned := 0
	for weight in weights:
		var exact := (weight / total_weight) * float(schedule_size)
		var count := floori(exact)
		counts.append(count)
		remainders.append(exact - float(count))
		assigned += count
	while assigned < schedule_size:
		var best_index := 0
		for index in range(1, remainders.size()):
			if remainders[index] > remainders[best_index]:
				best_index = index
		counts[best_index] += 1
		remainders[best_index] = -1.0
		assigned += 1
	for index in range(candidates.size()):
		for _slot in range(counts[index]):
			_region_schedule.append(candidates[index])
	for index in range(_region_schedule.size() - 1, 0, -1):
		var swap_index := rng.randi_range(0, index)
		var temporary := _region_schedule[index]
		_region_schedule[index] = _region_schedule[swap_index]
		_region_schedule[swap_index] = temporary


func _relocate_target() -> void:
	var spawn_pool := _target_spawn_pool()
	if spawn_pool.is_empty():
		_target_relocation_step = -1
		return
	var candidate := target.global_transform
	for _attempt in range(8):
		candidate = _sample_target_transform(_episode_rng, spawn_pool)
		if (
			candidate.origin.distance_to(target.global_position)
			>= maxf(minimum_target_relocation_distance, 0.0)
		):
			break
	_place_target(candidate)
	_target_relocation_step = -1
	arm.notify_target_pose_relocated()


func _sample_target_position(
		rng: RandomNumberGenerator,
		spawn_pool: Array[Marker3D],
		anchor: Vector3) -> Vector3:
	var lower := spawn_pool[0].global_position
	var upper := lower
	for marker in spawn_pool:
		lower = lower.min(marker.global_position)
		upper = upper.max(marker.global_position)

	var inset := Vector3(
		maxf(target_sampling_inset.x, 0.0),
		maxf(target_sampling_inset.y, 0.0),
		maxf(target_sampling_inset.z, 0.0))
	for axis in range(3):
		var half_extent := (upper[axis] - lower[axis]) * 0.5
		var axis_inset := minf(inset[axis], half_extent)
		lower[axis] += axis_inset
		upper[axis] -= axis_inset

	# Grow the sampling radius from each anchor to the full marker bounds.
	var frac := 1.0
	if spatial_curriculum_full_episode > spatial_curriculum_start_episode:
		frac = clampf(
			float(_curriculum_episode() - spatial_curriculum_start_episode)
			/ float(spatial_curriculum_full_episode - spatial_curriculum_start_episode),
			0.0, 1.0)
	var out_position := Vector3()
	for axis in range(3):
		var half_extent := (upper[axis] - lower[axis]) * 0.5
		var radius := lerpf(spatial_curriculum_start_radius, half_extent, frac)
		var sampled := anchor[axis] + rng.randf_range(-radius, radius)
		out_position[axis] = clampf(sampled, lower[axis], upper[axis])
	return out_position


func _sample_joint_offsets(rng:RandomNumberGenerator, max_degrees:float) -> Array[float]:
	var offsets: Array[float] = []
	offsets.resize(arm.get_joint_count())
	for index in range(offsets.size()):
		offsets[index] = deg_to_rad(rng.randf_range(-max_degrees, max_degrees))
	return offsets


func _sample_reset_joint_offsets(
			rng: RandomNumberGenerator,
			regular_jitter_degrees: float,
			use_regular_reset: bool) -> Array[float]:
	if use_regular_reset:
		return _sample_joint_offsets(rng, regular_jitter_degrees)

	var offsets: Array[float] = []
	var joint_count: int = arm.get_joint_count()
	offsets.resize(joint_count)
	var home_positions: PackedFloat32Array = arm.joint_home_positions
	var jitter_degrees := maxf(bootstrap_joint_jitter_degrees, 0.0)
	var active_joints := bootstrap_joint_positions
	if not bootstrap_pose_joints.is_empty():
		active_joints = bootstrap_pose_joints[clampi(
			_active_bootstrap_index, 0, bootstrap_pose_joints.size() - 1)]
	# With a ladder, the retreat already chose WHICH pose to start from, and that pose is a real
	# pre-grasp on the approach line. Interpolating it towards home would put the hand back off-axis
	# -- the very thing the ladder exists to avoid -- so the recorded angles are used as they are.
	var reverse_t := (
		1.0
		if maxi(bootstrap_rung_count, 1) > 1
		else _sample_reverse_reset_fraction(rng))
	for index in range(joint_count):
		var home := (
			float(home_positions[index])
			if index < home_positions.size()
			else 0.0)
		var demo := (
			float(active_joints[index])
			if index < active_joints.size()
			else home)
		# Interpolate between home and the demonstration pose.
		var reference := home + reverse_t * (demo - home)
		var absolute_position := reference
		absolute_position += deg_to_rad(rng.randf_range(
			-jitter_degrees, jitter_degrees))
		offsets[index] = absolute_position - home
	return offsets


## Pick which recorded pre-grasp starts this episode: a random cell, and a rung chosen by the
## retreat schedule rather than by chance, so the assist withdraws along the approach line.
##
## With bootstrap_rung_count == 1 there is no ladder and the index is a plain uniform draw; the
## retreat is then done by _sample_reset_joint_offsets interpolating joint angles, which is the old
## behaviour and is kept so scenes recorded before the ladder still run.
func _sample_bootstrap_index(rng: RandomNumberGenerator) -> int:
	var total := bootstrap_pose_joints.size()
	var rungs := maxi(bootstrap_rung_count, 1)
	if rungs <= 1 or total < rungs:
		return rng.randi_range(0, total - 1)
	var cells := total / rungs
	var cell := rng.randi_range(0, maxi(cells - 1, 0))
	# 1.0 means "at the grasp pose" -- rung 0. Retreating raises the rung.
	var reverse_t := _sample_reverse_reset_fraction(rng)
	var rung := clampi(roundi((1.0 - reverse_t) * float(rungs - 1)), 0, rungs - 1)
	return clampi(cell * rungs + rung, 0, total - 1)


## Maps 1.0 to the demo pose and 0.0 to the home pose.
func _sample_reverse_reset_fraction(rng: RandomNumberGenerator) -> float:
	# Demonstrations always record the full reach from home.
	if controller != null and controller.recording_mode:
		return 0.0
	if not reverse_curriculum_enabled:
		return 0.0  # home-start training (matches home-start demos)
	if reverse_curriculum_full_level <= 0.0:
		return 1.0
	# Episode pacing works with adaptive, fixed and SB3-driven curricula alike.
	var start := reverse_curriculum_start_episode
	var full := maxi(reverse_curriculum_full_episode, start + 1)
	var frac := clampf(
		float(_training_episode - start) / float(full - start), 0.0, 1.0)
	var t_low := clampf(1.0 - frac, 0.0, 1.0)
	return rng.randf_range(t_low, 1.0)


func _on_target_reached() -> void:
	goal_event.trigger(str(arm.name))
	if (
		_training_mode
		and relocate_target_during_training
		and _curriculum_episode() >= target_relocation_start_episode
	):
		var minimum_delay := mini(
			target_relocation_delay_steps_min,
			target_relocation_delay_steps_max)
		var maximum_delay := maxi(
			target_relocation_delay_steps_min,
			target_relocation_delay_steps_max)
		_target_relocation_step = (
			controller.step_count
			+ _episode_rng.randi_range(minimum_delay, maximum_delay))


func _on_target_pose_relocated() -> void:
	controller.rebase_agent_tracking(arm)


func _on_obstacle_collision() -> void:
	if transport_release_debug and transport_enabled:
		print("[urto] fase=%d attaccato=%s" % [
			_transport_phase,
			str(arm.has_method("is_grasp_attached") and arm.is_grasp_attached())])
	# Once per episode, not once per frame of overlap.
	#
	# The agent re-reports a collision every physics frame it is still inside something. That was
	# harmless while a collision ended the episode; now that it does not -- so an arm can graze the
	# table and still go on to grasp -- an unlatched event bills the flat penalty over and over.
	# Measured before this latch: a single misaligned approach collected -220 from eleven firings.
	# The CONTINUOUS cost of staying inside something is get_collision_contact_penalty; this event
	# is the one-off "you hit it at all".
	if _collision_event_fired:
		return
	_collision_event_fired = true
	# Keep self-collision and environment-collision penalties separate.
	var source := str(arm.get_last_collision_details().get("source", ""))
	if source == "self_body":
		self_collision_event.trigger(str(arm.name))
	else:
		collision_event.trigger(str(arm.name))


## Fades transport seeding out over training, the same way the grasp ladder fades.
func _transport_seed_fraction() -> float:
	if transport_seed_full_episode <= 0:
		return transport_seed_fraction
	var progress := clampf(
		float(_curriculum_episode()) / float(transport_seed_full_episode), 0.0, 1.0)
	return transport_seed_fraction * (1.0 - progress)


## Start this episode already holding the glass above the opening, with only the release left.
##
## Returns true when it took over the reset, so the caller skips putting the glass back on the table.
##
## The capture is NOT forced: the arm is posed, the glass is parked between the pads and the claws
## are set to the fit for its measured width, and then the ordinary capture rule fires on the next
## physics frame like any other grasp. A seeded episode therefore begins from a state the policy
## could have reached itself, which is the whole point -- a hand-declared attachment would teach the
## release from a state that never occurs in play.
func _apply_transport_seed() -> bool:
	if not _transport_seeded_episode or grasp_target == null or arm == null:
		return false
	if transport_seed_pose_joints.is_empty():
		return false
	var robot := arm.get_node_or_null("openarm")
	if robot == null or not robot.has_method("reset_joint_positions"):
		return false
	var names: PackedStringArray = arm.get_controlled_joint_names()
	var base := _sample_transport_seed_rung() * names.size()
	var pose := {}
	for j in range(names.size()):
		var index := base + j
		pose[String(names[j])] = (
			float(transport_seed_pose_joints[index])
			if index < transport_seed_pose_joints.size()
			else 0.0)
	robot.reset_joint_positions(pose)

	var tool: Node3D = arm.tool_pose
	if tool == null:
		return false
	# Upright, because a glass on its side counts as knocked over and would end the episode before
	# the policy did anything. It is a solid of revolution, so its yaw carries no information.
	var held := Transform3D(Basis.IDENTITY, tool.global_position)
	var rid := grasp_target.get_rid()
	PhysicsServer3D.body_set_state(rid, PhysicsServer3D.BODY_STATE_TRANSFORM, held)
	PhysicsServer3D.body_set_state(rid, PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY, Vector3.ZERO)
	PhysicsServer3D.body_set_state(rid, PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY, Vector3.ZERO)
	grasp_target.global_transform = held
	grasp_target.linear_velocity = Vector3.ZERO
	grasp_target.angular_velocity = Vector3.ZERO
	_refresh_debug_overlays()
	if transport_release_debug:
		print("[seme-avvio] mano a %.4f m dal punto di rilascio" % (
			(arm.tool_pose as Node3D).global_position.distance_to(_release_point)))
	return true


## Let go of anything still held, unconditionally, at the start of every reset.
##
## `_release_object` otherwise fires only when the CLAWS OPEN past the fit, so an episode that ended
## while carrying -- which truncation at the step limit causes constantly -- handed the glass to the
## next episode still welded to the hand. `_on_episode_reset_completed` then returned early precisely
## because it was attached, so the glass was never put back on the table either.
##
## This was invisible until the glass changed. At the home opening the pad gap is 45 mm; the old
## narrower glass left 15 mm of slack, comfortably past the 5 mm release threshold, so the reset
## released by coincidence of geometry. The 40 mm glass leaves exactly 5 mm -- not MORE than the
## threshold -- and the coincidence stopped holding. Releasing explicitly does not depend on the
## gripper's dimensions at all.
func _release_object_for_reset() -> void:
	if grasp_target == null or arm == null or not arm.has_method("is_grasp_attached"):
		return
	if arm.is_grasp_attached():
		_release_object()


## Re-baseline the stall guard whenever the goal moves.
##
## `ProgressStallScenarioReward` keeps the best progress seen SO FAR IN THE EPISODE and terminates
## when it is not beaten within the window. That is right for a single fixed goal and wrong for a
## chain: at every phase change the demanded pose jumps -- to 15 cm above the grasp, then to the bin,
## then home -- so the distance grows, progress falls below a best that was measured against a
## NEARER target, and the arm has to beat that old figure against a farther one. The guard then cuts
## episodes that are doing exactly what the task asks. `progress_stalled` was 41 of 100 evaluated
## episodes and by far the dominant failure once collisions and tipping had faded.
##
## The component exposes `reset_agent`, which re-baselines to the current progress and clears the
## counter -- the same thing an episode reset does, which is the correct semantics here: the goal
## changed, so the history against the old goal is meaningless.
func _rebaseline_stall_guard() -> void:
	if stall_reward == null or arm == null or not stall_reward.has_method("reset_agent"):
		return
	stall_reward.call("reset_agent", str(arm.name), {
		"progress": float(arm.get_progress()),
		"step": int(controller.step_count),
	})


## Which rung of the carry ladder to start from, retreating with training.
##
## Rung 0 is above the bin, where only the drop is left; the last rung is back at the grasp, where
## the whole carry has to be flown. Early episodes draw from the shallow end so the release is
## experienced at all, and the reachable depth grows on the same clock the seeding fraction fades on.
func _sample_transport_seed_rung() -> int:
	var rungs: int = maxi(transport_seed_rung_count, 1)
	if rungs <= 1:
		return 0
	var horizon := maxi(transport_seed_full_episode, 1)
	var progress := clampf(float(_curriculum_episode()) / float(horizon), 0.0, 1.0)
	var deepest := int(round(progress * float(rungs - 1)))
	return _episode_rng.randi_range(0, deepest)
