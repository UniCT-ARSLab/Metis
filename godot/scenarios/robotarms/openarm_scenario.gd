@export_category("Grasp Target")
## The graspable RigidBody3D (a glass).
@export var grasp_target: RigidBody3D
## The grasp marker inside grasp_target.
@export var grasp_target_pose: Node3D
## Table used to derive the resting height and the reachable footprint.
@export var grasp_support_body: PhysicsBody3D
## Extra clearance demanded between the glass rim and the table edge when checking the sampling regions.
@export var grasp_support_margin := 0.005
## Slack added to the measured grasp window when deciding whether the object is between the pads.
## The window is the overlap of the two pad faces, so zero slack would demand a perfect placement;
## this is how much of the object may hang outside it and still count.
@export var grasp_capture_tolerance := 0.004
## How far past a perfect fit the claws may be and still capture. Negative side: the pads have gone
## into the object (modelled squeeze). Positive side: they have not reached it yet.
@export var grasp_capture_gap_tolerance := 0.004
## An object still moving has been knocked, not grasped.
@export var grasp_capture_max_object_speed := 0.05
## Extra opening, past a perfect fit, at which a held object is let go again.
##
## MEASURED, not chosen: `tools/local/openarm_release_gap_probe.gd` opens the claws one millimetre at a
## time on a held glass and reports the gap at which it actually falls -- 48.0 mm on a 40.0 mm glass,
## identical across six trials. With the capture tolerance at 1 mm, the release was being declared at
## 45 mm, three millimetres before the object could physically leave: it stayed resting on the finger
## structure below the pads, where kinematic fingers hold it indefinitely. 44 of 54 spills were a
## glass parked over the open bin, so the policy collected -20 for a release aimed correctly and was
## being taught not to open over the bin at all.
@export var grasp_release_clearance := 0.009
## Tilt, in degrees off vertical, at which the object counts as knocked over.
@export var grasp_tip_degrees := 30.0

@export_category("Transport")
## Carry the glass to the bin and go home, instead of ending the episode at the grasp.
##
## Default OFF: with this false the scenario behaves exactly as the solved grasp task did, so the
## v1 checkpoints stay comparable and no other scene changes behaviour.
##
## The observation and action contract does NOT change when this is on. The arm always tracks
## `_demanded_pose`, so a phase is expressed by MOVING that marker -- the position-error blocks
## become the lift error, then the carry error, then the way home, with nothing added to the vector.
## That is what lets transport warm-start from the grasp actor instead of training from scratch.
@export var transport_enabled := false
## Area covering the inside of the bin. A release counts only if the glass ends up in here.
@export var transport_drop_area: Area3D
## How far above the grasp the glass is lifted before carrying it.
@export var transport_lift_height := 0.15
## How far above the bin RIM the release waypoint sits. 0.15 measured clear: the probe reached the
## opening centre to within 7 mm with 80 mm of self-clearance and no contact.
@export var transport_release_height := 0.15
## How close the tool must come to a waypoint for the phase to advance.
##
## MUST stay looser than `success_distance`, or the arm can satisfy its own success gate while
## hovering at a waypoint and end the episode halfway through the task. Checked at _ready.
@export var transport_waypoint_distance := 0.05
## Physics frames allowed for a released glass to reach the bin before the drop is judged.
@export var transport_drop_grace_frames := 120
## Poses that hold the glass along the CARRY route, laid end to end -- rung 0 above the bin, the last
## rung back at the grasp. Generated by `tools/local/openarm_carry_ladder_generator.gd`. Empty disables
## transport seeding.
@export var transport_seed_pose_joints := PackedFloat32Array()
## How many rungs `transport_seed_pose_joints` holds. 1 means the single release pose.
##
## Why a ladder and not one pose: measured over 246 releases in real episodes, 3% happened within
## 10 cm of the bin (median 30 cm) and that did not budge across 640 episodes after the reward was
## corrected -- while SEEDED episodes, starting above the bin, released over it 100% of the time. The
## arm was not missing a signal, it was missing experience of the route. Rungs put that stretch into
## the replay the same way the grasp ladder did for the approach.
@export var transport_seed_rung_count := 1
## Fraction of episodes that START already holding the glass above the opening.
##
## The reverse curriculum solved the grasp by seeding near the goal and retreating, and transport
## needs it for a sharper reason: measured over 560 evaluated episodes the arm released the glass
## ZERO times -- not once, not even badly -- because almost nothing reached the carry phase, so the
## release incentive was never experienced and the +25 for delivery never entered the replay at all.
## Seeding puts the release, and its reward, in the buffer from the first episode.
@export_range(0.0, 1.0, 0.05) var transport_seed_fraction := 0.4
## Episode by which transport seeding has faded to nothing.
@export var transport_seed_full_episode := 12000
## Print where each release happened. Diagnostic only: distinguishes "opens early on the way" from
## "arrives over the bin and opens late", which need opposite fixes.
@export var transport_release_debug := false
## Radius around the release point inside which opening the claws is rewarded, in metres.
@export var transport_release_incentive_radius := 0.10
## Pad-gap opening PAST the object width that scores a full release incentive, in metres.
## Deliberately larger than the release threshold so the reward is still climbing when the glass
## leaves the hand, instead of peaking exactly there.
@export var transport_release_open_span := 0.04

enum TransportPhase { GRASP, LIFT, CARRY, HOME }
## Hold requirement used to make success unreachable before the glass is delivered.
const SUCCESS_SUPPRESSED_FRAMES := 1000000
## Clearance from the arm's own body under which the proximity cost starts, in metres. Above the
## widest bracket the clearance measurement reports, so the cost is defined over its whole range.
@export var self_proximity_threshold := 0.08
## End the episode when the object is knocked over.
##
## Not merely tidiness: once the glass is on its side the demanded grasp pose stays upright in world
## (it is rewritten every frame so a knock cannot drag it), so the capture condition can never fire
## again -- the episode is unwinnable. Left running, the arm keeps collecting approach shaping for
## the remaining hundreds of steps of a task it has already lost, which is the same farming
## pathology the stall guard exists to stop.
@export var terminate_on_tipped_object := true
## Displacement at which the disturbance penalty reaches its full -1. Zero derives it from the
## object -- its own radius -- so "shoved by its own width" is the worst case instead of a round
## number someone typed.
@export var grasp_disturbance_scale := 0.0
## Penetration depth at which the squeeze penalty reaches its full -1. Zero derives it from the
## object: half its width is as deep as the pads can possibly go, so full closure reads exactly -1
## and everything short of it is distinguishable.
##
## This one was measured the hard way. A hand-picked 10 mm made a normal close (17.5 mm) and a
## deliberate crush (22.5 mm) score IDENTICALLY, both clamped -- the penalty was present in the sum
## and blind to the thing it was supposed to grade.
@export var grasp_penetration_scale := 0.0
## How much wider than the object the claws start.
@export var grasp_initial_clearance := 0.015

