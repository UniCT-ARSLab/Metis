# Scratch that belongs to an experiment, not to the framework: probes, one-off tests, generated
# scenes. Put it in a `local/` directory next to the code it refers to and it stays out of the repo.
# Any depth, anywhere.
local/
.metis/
dist/
python/build/
python/dist/
python/*.egg-info/
python/.venv/
python/.venv-sb3/
experiments
tmp
research
*.h5
# The whole directory, not just *.log: the .pid files written next to the logs were being tracked.
logs/
__pycache__/
*.py[cod]
